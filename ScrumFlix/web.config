<?xml version="1.0" encoding="utf-8"?>
<!--
  File: /ScrumFlix/web.config
  Description: IIS / Somee.com deployment configuration for the ScrumFlix ASP.NET Core MVC
               application. Configures the ASP.NET Core Module v2 (ANCM) to host the app in
               out-of-process mode, injects production secrets as environment variables, sets
               standard security and performance headers, enables static file serving, and
               suppresses default IIS error pages so ASP.NET Core handles all responses.

  ╔══════════════════════════════════════════════════════════════════════════════════════╗
  ║  THIS FILE IS THE PLACEHOLDER TEMPLATE — COMMITTED TO SOURCE CONTROL               ║
  ╠══════════════════════════════════════════════════════════════════════════════════════╣
  ║                                                                                      ║
  ║  All <environmentVariable value=""> attributes are intentionally blank here.         ║
  ║  Real production values are supplied by web.Production.config at publish time        ║
  ║  via XML Document Transform (XDT). Do NOT add real credentials to this file.        ║
  ║  This file IS committed to source control.                                           ║
  ║                                                                                      ║
  ║  PUBLISH WORKFLOW:                                                                   ║
  ║    dotnet publish -c Release                                                         ║
  ║    The MSBuild XDT pipeline applies web.Production.config automatically when the     ║
  ║    configuration is Release and web.Production.config is present alongside this      ║
  ║    file. The transform injects real credentials into the published web.config        ║
  ║    before it is uploaded to Somee.com. web.Production.config is NEVER committed.    ║
  ║                                                                                      ║
  ║  WHY NOT USER SECRETS?                                                               ║
  ║    dotnet User Secrets are a development-only mechanism. ASP.NET Core only loads     ║
  ║    them when ASPNETCORE_ENVIRONMENT = "Development". A Release publish always        ║
  ║    targets Production, so User Secrets are never included in build output and        ║
  ║    are never available to a running production app — by design.                      ║
  ║                                                                                      ║
  ║  WHY NOT THE SOMEE.COM CONTROL PANEL?                                                ║
  ║    Somee's "Application Settings" panel sets IIS-level app settings, which are      ║
  ║    NOT injected into the <environmentVariables> block that ASP.NET Core reads.       ║
  ║    Values set there are silently ignored by the runtime. Credentials must be         ║
  ║    placed directly in the <environmentVariables> block below.                        ║
  ║                                                                                      ║
  ║  WHY NOT appsettings.json?                                                           ║
  ║    appsettings.json is committed to source control and deployed with the build.      ║
  ║    It must never contain real credentials. All secret values in appsettings.json     ║
  ║    are intentionally left blank — they are overridden at runtime by the              ║
  ║    environment variables injected by web.Production.config, which take the highest   ║
  ║    precedence in the ASP.NET Core configuration pipeline.                            ║
  ║                                                                                      ║
  ║  KEY NAMING CONVENTION:                                                              ║
  ║    ASP.NET Core maps environment variable names to config keys by replacing          ║
  ║    double-underscores (__) with colons (:).                                          ║
  ║    e.g.  Email__SmtpPassword  →  Email:SmtpPassword  in IConfiguration              ║
  ║          Tmdb__ApiKey         →  Tmdb:ApiKey                                         ║
  ║                                                                                      ║
  ║  SOURCE CONTROL:                                                                     ║
  ║    This placeholder template IS committed. web.Production.config is NOT.            ║
  ║    Keep web.Production.config in a secure password manager or team vault.            ║
  ║
  ║  PUBLISH WORKFLOW:                                                                   ║
  ║    1. Ensure this file exists in the project root with real values filled in.        ║
  ║    2. Run: dotnet publish -c Release                                                 ║
  ║    3. Upload the /publish output folder to Somee.com.                                ║
  ║    4. Upload this web.config to the site root, overwriting the generated one.        ║
  ║    No further editing of the live site is ever required.                             ║
  ║                                                                                      ║
  ╚══════════════════════════════════════════════════════════════════════════════════════╝
-->
<configuration>

	<location path="." inheritInChildApplications="false">
		<system.webServer>

			<!-- ── ASP.NET Core Module v2 (out-of-process hosting) ───────────────────────
           processPath: Somee.com provides the .NET runtime; dotnet.exe is on the PATH.
           arguments:   Points to the compiled app DLL by name.
           hostingModel: "outofprocess" — ANCM proxies requests to a separate dotnet
                         process. More isolated than inprocess; required on shared hosts
                         that don't allow inprocess CLR loading.
           stdoutLogEnabled: Keep FALSE in normal production. Flip to TRUE only when
                         diagnosing startup crashes (app won't start at all), then
                         immediately revert and delete the logs/ folder afterward.
           ─────────────────────────────────────────────────────────────────────────── -->
			<handlers>
				<add name="aspNetCore"
					 path="*"
					 verb="*"
					 modules="AspNetCoreModuleV2"
					 resourceType="Unspecified" />
			</handlers>

			<aspNetCore processPath="dotnet"
						arguments=".\ScrumFlix.dll"
						stdoutLogEnabled="false"
						stdoutLogFile=".\logs\stdout"
						hostingModel="outofprocess">
				<environmentVariables>

					<!-- Tells ASP.NET Core to use Production configuration, which disables
               Developer Exception Pages, enables error handling middleware, and
               prevents User Secrets from loading. -->
					<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

					<!-- ── Database ──────────────────────────────────────────────────────────
               Maps to: ConnectionStrings:MySQLConnection in IConfiguration.
               Used by: DbContext / Entity Framework Core (Aiven MySQL via SSL).
               ──────────────────────────────────────────────────────────────────── -->
					<environmentVariable name="ConnectionStrings__MySQLConnection"
										 value="" />

					<!-- ── TMDb API ──────────────────────────────────────────────────────────
               Maps to: Tmdb:ApiKey in IConfiguration.
               Used by: TMDb sync service (movie metadata, posters, ratings).
               ──────────────────────────────────────────────────────────────────── -->
					<environmentVariable name="Tmdb__ApiKey" value="" />

					<!-- ── Serilog email alert sink ──────────────────────────────────────────
               Maps to: Logging:Email:* in IConfiguration.
               Used by: Serilog's email sink — fires on Error/Fatal log events.
               DISTINCT from the transactional EmailService block below.
               If any of these are blank, the sink is silently skipped at startup.
               ──────────────────────────────────────────────────────────────────── -->
					<environmentVariable name="Logging__Email__SmtpHost"     value="" />
					<environmentVariable name="Logging__Email__SmtpPort"     value="587" />
					<environmentVariable name="Logging__Email__SmtpUser"     value="" />
					<environmentVariable name="Logging__Email__SmtpPassword" value="" />
					<environmentVariable name="Logging__Email__From"         value="" />
					<environmentVariable name="Logging__Email__To"           value="" />

					<!-- ── Transactional email (EmailService / IEmailService) ────────────────
               Maps to: Email:* in IConfiguration.
               Used by: Order confirmations, concession receipts, staff notifications,
               and PDF delivery. DISTINCT from the Serilog alert sink above.
               If any of these are blank, EmailService logs a warning and skips
               delivery silently — checkout is never blocked by missing email config.
               ──────────────────────────────────────────────────────────────────── -->
					<environmentVariable name="Email__SmtpHost"     value="" />
					<environmentVariable name="Email__SmtpPort"     value="587" />
					<environmentVariable name="Email__SmtpUser"     value="" />
					<environmentVariable name="Email__SmtpPassword" value="" />
					<environmentVariable name="Email__From"         value="" />
					<environmentVariable name="Email__FromName"     value="ScrumFlix" />
					<environmentVariable name="Email__AdminTo"      value="" />

				</environmentVariables>

				<!-- ── Shadow copy ───────────────────────────────────────────────────────────
             Copies app binaries to a shadow directory before the process starts,
             allowing the original files to be overwritten during a live deployment
             without causing file-lock errors on Somee.com's shared hosting.
             ──────────────────────────────────────────────────────────────────────── -->
				<handlerSettings>
					<handlerSetting name="enableShadowCopy"         value="true" />
					<handlerSetting name="shadowCopyDirectory"      value="../Protected.scrumflixtheatres.somee.com/ShadowCopy" />
					<handlerSetting name="cleanShadowCopyDirectory" value="true" />
				</handlerSettings>
			</aspNetCore>

			<!-- ── Static files ──────────────────────────────────────────────────────────
           IIS doesn't know woff/woff2 MIME types by default. Remove-then-add avoids
           a duplicate MIME type error if the server already has a partial definition.
           ─────────────────────────────────────────────────────────────────────────── -->
			<staticContent>
				<remove fileExtension=".woff"  />
				<remove fileExtension=".woff2" />
				<mimeMap fileExtension=".woff"  mimeType="font/woff"  />
				<mimeMap fileExtension=".woff2" mimeType="font/woff2" />
			</staticContent>

			<!-- ── Security headers ──────────────────────────────────────────────────────
           X-Content-Type-Options: Blocks MIME-type sniffing attacks.
           X-Frame-Options:        Prevents the site being embedded in iframes
                                   (clickjacking protection); SAMEORIGIN allows
                                   same-domain frames (e.g. seat map embeds).
           X-XSS-Protection:       Enables the XSS auditor in older browsers that
                                   predate CSP support (belt-and-suspenders).
           X-Powered-By:           Removed to avoid advertising the server stack.
           ─────────────────────────────────────────────────────────────────────────── -->
			<httpProtocol>
				<customHeaders>
					<add    name="X-Content-Type-Options" value="nosniff" />
					<add    name="X-Frame-Options"        value="SAMEORIGIN" />
					<add    name="X-XSS-Protection"       value="1; mode=block" />
					<remove name="X-Powered-By" />
				</customHeaders>
			</httpProtocol>

			<!-- ── HTTP → HTTPS redirect ─────────────────────────────────────────────────
           Permanently redirects all plain HTTP traffic to HTTPS.
           The {R:1} back-reference preserves the full request path and query string.
           stopProcessing="true" prevents any further rewrite rules from running
           after this redirect fires.
           ─────────────────────────────────────────────────────────────────────────── -->
			<rewrite>
				<rules>
					<rule name="HTTP to HTTPS" stopProcessing="true">
						<match url="(.*)" />
						<conditions>
							<add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
						</conditions>
						<action type="Redirect"
								url="https://{HTTP_HOST}/{R:1}"
								redirectType="Permanent" />
					</rule>
				</rules>
			</rewrite>

			<!-- ── Error page passthrough ─────────────────────────────────────────────────
           Tells IIS not to intercept error responses and replace them with its own
           default error pages. ASP.NET Core's own middleware handles all 4xx/5xx
           responses, including custom error views and the developer exception page.
           ─────────────────────────────────────────────────────────────────────────── -->
			<httpErrors existingResponse="PassThrough" />

			<!-- ── Request size limit ─────────────────────────────────────────────────────
           10 MB ceiling covers ticket bookings, concession order posts, and any
           admin file uploads without being excessively permissive.
           IIS enforces this before the request reaches ASP.NET Core, so it acts
           as a first-line guard against oversized payloads.
           ─────────────────────────────────────────────────────────────────────────── -->
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="10485760" />
				</requestFiltering>
			</security>

		</system.webServer>
	</location>

</configuration>