@*
 * File: /ScrumFlix/Views/Account/ChangePassword.cshtml
 * Description: Password change form for ScrumFlix employees.
 *              Used in two modes:
 *                - Forced (IsForced=true): MustChangePassword=true on the account
 *                - Voluntary: accessed from the navbar user menu at any time
 *              Phase 3 — Token Compliance Sweep:
 *                - All inline style="" attributes removed
 *                - Old primitive tokens (--sf-gold, --sf-white, --sf-muted,
 *                  --sf-dark-card, --sf-dark-alt, --sf-border, raw rgba() values)
 *                  replaced with semantic sf-* component classes and tokens
 *                - Flash banners use .sf-flash-banner variants
 *                - Form fields use .sf-label / .sf-input / .sf-validation
 * Phase: 3
 *@

@model ScrumFlix.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = Model.IsForced ? "Password Change Required" : "Change Password";
}

<div class="container-xl py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-9 col-md-7 col-lg-5 col-xl-4">

            @* ── Header ──────────────────────────────────────────────────── *@
            <div class="text-center mb-4">
                <i class="bi @(Model.IsForced ? "bi-shield-lock-fill" : "bi-key-fill") sf-icon-accent"
                   aria-hidden="true"
                   class="sf-icon-lg"></i>
                <h1 class="mt-2 mb-1 sf-display-heading">
                    @(Model.IsForced ? "Password Change Required" : "Change Password")
                </h1>
                @if (Model.IsForced)
                {
                    <p class="mb-0 sf-text-muted">
                        You must set a new password before continuing.
                    </p>
                }
                else
                {
                    <p class="mb-0 sf-text-muted">
                        Logged in as <strong class="sf-text-primary">@Context.Session.GetString("UserName")</strong>
                    </p>
                }
            </div>

            @* ── Forced-change notice banner ────────────────────────────── *@
            @if (Model.IsForced)
            {
                <div class="sf-flash-banner sf-flash-banner--warning d-flex align-items-start gap-2 mb-3"
                     role="alert">
                    <i class="bi bi-exclamation-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
                    <div>
                        Your account has been flagged to require a password change. This is
                        typically set by an administrator when your account is first created or
                        after a security reset. Choose a strong password you haven&rsquo;t used before.
                    </div>
                </div>
            }

            @* ── Card ───────────────────────────────────────────────────── *@
            <div class="sf-form-card">

                <form asp-action="ChangePassword" asp-controller="Account"
                      method="post" novalidate>

                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IsForced" />

                    @* Summary validation errors *@
                    <div asp-validation-summary="ModelOnly"
                         class="sf-flash-banner sf-flash-banner--error d-flex align-items-start gap-2 mb-3"
                         role="alert"
>
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
                        <div></div>
                    </div>

                    @* Current Password *@
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="sf-label">
                            CURRENT PASSWORD
                        </label>
                        <div class="position-relative">
                            <input asp-for="CurrentPassword"
                                   type="password"
                                   id="currentPasswordInput"
                                   class="sf-input pe-5"
                                   placeholder="Your current password"
                                   autocomplete="current-password"
                                   aria-describedby="currentPassword-error" />
                            <button type="button"
                                    class="sf-pw-toggle btn position-absolute top-50 end-0 translate-middle-y pe-3"
                                    data-target="currentPasswordInput"
                                    aria-label="Show current password"
                                    aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword"
                              id="currentPassword-error"
                              class="sf-validation d-block mt-1"></span>
                    </div>

                    @* New Password *@
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="sf-label">
                            NEW PASSWORD
                        </label>
                        <div class="position-relative">
                            <input asp-for="NewPassword"
                                   type="password"
                                   id="newPasswordInput"
                                   class="sf-input pe-5"
                                   placeholder="At least 8 characters"
                                   autocomplete="new-password"
                                   aria-describedby="newPassword-error newPassword-hint" />
                            <button type="button"
                                    class="sf-pw-toggle btn position-absolute top-50 end-0 translate-middle-y pe-3"
                                    data-target="newPasswordInput"
                                    aria-label="Show new password"
                                    aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword"
                              id="newPassword-error"
                              class="sf-validation d-block mt-1"></span>
                        <small id="newPassword-hint" class="sf-field-hint">
                            8–128 characters.
                        </small>
                    </div>

                    @* Confirm New Password *@
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="sf-label">
                            CONFIRM NEW PASSWORD
                        </label>
                        <div class="position-relative">
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   id="confirmPasswordInput"
                                   class="sf-input pe-5"
                                   placeholder="Re-enter new password"
                                   autocomplete="new-password"
                                   aria-describedby="confirmPassword-error" />
                            <button type="button"
                                    class="sf-pw-toggle btn position-absolute top-50 end-0 translate-middle-y pe-3"
                                    data-target="confirmPasswordInput"
                                    aria-label="Show confirm password"
                                    aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword"
                              id="confirmPassword-error"
                              class="sf-validation d-block mt-1"></span>
                    </div>

                    @* Submit *@
                    <div class="d-grid">
                        <button type="submit" class="sf-btn-primary sf-btn-display">
                            <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                            SET NEW PASSWORD
                        </button>
                    </div>

                    @* Cancel link — hidden on forced change *@
                    @if (!Model.IsForced)
                    {
                        <div class="text-center mt-3">
                            <a asp-controller="Home" asp-action="HomeDashboard"
                               class="sf-back-link">
                                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Cancel
                            </a>
                        </div>
                    }

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script src="~/js/account-change-password.js"
            asp-append-version="true"></script>
}
