@*
 * File: Views/Home/Error500.cshtml
 * Standalone error page for HTTP 500+ (server errors).
 * Layout = null — deliberately no layout dependency, because the layout itself
 * may be broken or unavailable during a 500-level failure.
 * Inline styles and CDN Bootstrap only — no local CSS files referenced.
 *@
@model ScrumFlix.ViewModels.ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.FriendlyTitle — ScrumFlix</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: #0d0d1a;
            color: #e8e8e8;
            font-family: system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .err-wrap   { max-width: 640px; width: 100%; text-align: center; }
        .err-code   {
            font-size: 7rem;
            font-weight: 800;
            background: linear-gradient(135deg, #c9a84c, #f0c060);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1;
        }
        .err-icon   { font-size: 3rem; color: #c9a84c; margin-bottom: .75rem; }
        .err-dev    {
            background: #13131f;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 8px;
            padding: 1.5rem;
            text-align: left;
            margin-top: 2rem;
        }
        .err-dev code { font-size: .78rem; color: #87ceeb; }
        .btn-gold  {
            background: #c9a84c; color: #000; font-weight: 600;
            padding: .6rem 1.6rem; border-radius: 6px;
            text-decoration: none; display: inline-block; margin: .25rem;
        }
        .btn-ghost {
            border: 1px solid rgba(255,255,255,.25); color: #e8e8e8;
            padding: .6rem 1.6rem; border-radius: 6px;
            text-decoration: none; display: inline-block; margin: .25rem;
        }
        .btn-gold:hover  { background: #b8943e; color: #000; }
        .btn-ghost:hover { background: rgba(255,255,255,.08); color: #fff; }
        dl.dev-grid {
            display: grid;
            grid-template-columns: max-content 1fr;
            gap: .25rem .75rem;
            font-size: .8rem;
            margin: 0;
        }
        dl.dev-grid dt { color: #87ceeb; }
        dl.dev-grid dd { margin: 0; }
    </style>
</head>
<body>
    <div class="err-wrap">

        <div class="err-icon">
            <i class="bi @Model.IconClass" aria-hidden="true"></i>
        </div>

        <div class="err-code">@Model.StatusCode</div>

        <h1 style="font-size:1.7rem; font-weight:700; margin:.75rem 0 .5rem;">
            @Model.FriendlyTitle
        </h1>

        <p style="color:#aaa; max-width:460px; margin:0 auto 1.75rem;">
            @Model.FriendlyMessage
        </p>

        <div>
            <a href="/" class="btn-gold">
                <i class="bi bi-house-door me-1"></i>Return to Home
            </a>
            <a href="javascript:history.back()" class="btn-ghost">
                <i class="bi bi-arrow-left me-1"></i>Go Back
            </a>
        </div>

        @if (Model.ShowDetail)
        {
            <div class="err-dev">
                <h2 style="font-size:.9rem; font-weight:700; margin-bottom:.75rem; color:#f0c060;">
                    <i class="bi bi-bug me-1" aria-hidden="true"></i>Developer / Staff Detail
                </h2>
                <dl class="dev-grid">
                    <dt>Status</dt>
                    <dd><code>@Model.StatusCode</code></dd>

                    <dt>Path</dt>
                    <dd><code>@Model.OriginalPath</code></dd>

                    <dt>Request ID</dt>
                    <dd><code>@Model.RequestId</code></dd>

                    @if (Model.IsStaff)
                    {
                        <dt>Session</dt>
                        <dd><code>Staff session active</code></dd>
                    }
                </dl>
                <p style="margin-top:.75rem; font-size:.75rem; color:#777;">
                    Full stack trace is in <strong>Serilog</strong> logs
                    (console in Development, MySQL in Production).
                    Search by Request ID above.
                </p>
            </div>
        }

    </div>
</body>
</html>
