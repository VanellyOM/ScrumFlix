@*
 * File: /ScrumFlix/Views/Movies/MovieCreate.cshtml
 * Description: Form for creating a new movie entry.
*@
@model Movie
@{
	ViewData["Title"] = "Add Movie";
}

<div class="sf-page-header">
	<div class="container-xl">
		<h1 class="sf-page-title"><i class="bi bi-plus-circle me-2"></i>Add Movie</h1>
	</div>
</div>

<section class="sf-section">
	<div class="container-xl">
		<div class="row justify-content-center">
			<div class="col-lg-6">
				<div class="sf-form-card">
					<form asp-controller="Movies" asp-action="MovieCreate" method="post">
						@Html.AntiForgeryToken()
						<div asp-validation-summary="ModelOnly" class="sf-flash-banner sf-flash-banner--error mb-4" role="alert"></div>

						<div class="mb-3">
							<label asp-for="Title" class="sf-label"></label>
							<input asp-for="Title" class="sf-input" placeholder="e.g. The Last Orbit" />
							<span asp-validation-for="Title" class="sf-validation"></span>
						</div>
						<div class="mb-3">
							<label asp-for="Genre" class="sf-label"></label>
							<input asp-for="Genre" class="sf-input" placeholder="e.g. Sci-Fi" />
							<span asp-validation-for="Genre" class="sf-validation"></span>
						</div>
						<div class="mb-3">
							<label asp-for="Rating" class="sf-label"></label>
							<select asp-for="Rating" class="sf-select">
								<option value="">Select rating…</option>
								<option value="G">G</option>
								<option value="PG">PG</option>
								<option value="PG-13">PG-13</option>
								<option value="R">R</option>
								<option value="NC-17">NC-17</option>
							</select>
							<span asp-validation-for="Rating" class="sf-validation"></span>
						</div>
						<div class="mb-4">
							<label asp-for="RuntimeMinutes" class="sf-label"></label>
							<input asp-for="RuntimeMinutes" class="sf-input" type="number" min="1" placeholder="Runtime in minutes" />
							<span asp-validation-for="RuntimeMinutes" class="sf-validation"></span>
						</div>

						<div class="mb-4">
							<label asp-for="Description" class="sf-label"></label>
							<textarea asp-for="Description" class="sf-input" rows="4"
									  placeholder="Plot synopsis (up to 1000 characters)…"></textarea>
							<span asp-validation-for="Description" class="sf-validation"></span>
						</div>
						<div class="d-flex gap-3">
							<button type="submit" class="sf-btn-primary flex-grow-1">
								<i class="bi bi-plus-circle me-2"></i>Add Movie
							</button>
							<a asp-action="MovieCatalog" class="sf-btn-ghost">Cancel</a>
							@*  <a asp-controller="Movies" asp-action="MovieCatalog" class="btn sf-btn-outline">Cancel</a> *@
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
