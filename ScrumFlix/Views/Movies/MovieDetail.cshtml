@*
 * File: Views/Movies/MovieDetail.cshtml
 * Model: ScrumFlix.ViewModels.MovieDetailViewModel
 *
 * Thin full-page wrapper. All content lives in _MovieDetailPartial.cshtml,
 * which is also served by Admin/Movies/MovieDetailPreview for the modal preview.
 *@
@model ScrumFlix.ViewModels.MovieDetailViewModel
@{
    ViewData["Title"] = Model.Movie.Title;
}

@await Html.PartialAsync("_MovieDetailPartial", Model)

@section Scripts {
    <script src="~/js/sf-movie-detail.js" asp-append-version="true"></script>
}
