{
    /*
   * appsettings.json — ScrumFlix production baseline configuration.
   *
   * SECRETS (never put real values here):
   *   ConnectionStrings:MySQLConnection  — use User Secrets (dev) or env vars (prod)
   *   Logging:Email:SmtpPassword         — use User Secrets (dev) or env vars (prod)
   *
   * ENV VAR OVERRIDE PATTERN (production / IIS / Azure):
   *   JSON key  "ConnectionStrings:MySQLConnection"
   *   Env var   "ConnectionStrings__MySQLConnection"   (double underscore = colon)
   *
   * SERILOG LEVEL REFERENCE:
   *   Verbose | Debug | Information | Warning | Error | Fatal
   */

    "ConnectionStrings": {
        /*
     * Placeholder — real value set via:
     *   dotnet user-secrets set "ConnectionStrings:MySQLConnection" "Server=...;..."
     *
     * Aiven MySQL connection string format:
     *   Server=mysql-xxx.aivencloud.com;Port=12345;Database=defaultdb;
     *   User=avnadmin;Password=SECRET;SslMode=Required;
     */
        "MySQLConnection": ""
    },

    /*
     * Serilog section — minimum levels and enrichers read by LoggingConfiguration.cs
     * via .ReadFrom.Configuration(). Overrides here take effect without recompiling.
     *
     * ENV VAR OVERRIDE (production):
     *   JSON key  "Serilog:MinimumLevel:Default"
     *   Env var   "Serilog__MinimumLevel__Default"
     *
     * To temporarily enable Debug in Production, set:
     *   Serilog__MinimumLevel__Default=Debug  in web.config environmentVariables.
     *
     * LEVEL REFERENCE: Verbose | Debug | Information | Warning | Error | Fatal
     */
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft":                                    "Warning",
                "Microsoft.Hosting.Lifetime":                   "Information",
                "Microsoft.EntityFrameworkCore":                "Warning",
                "Microsoft.EntityFrameworkCore.Database":       "Warning",
                "Microsoft.AspNetCore.StaticFiles":             "Error",
                "System.Net.Http.HttpClient":                   "Warning"
            }
        },
        /*
         * Serilog.Expressions global noise filter.
         * Applied to ALL sinks before any event is written.
         * Rules here are the production baseline — see appsettings.Development.json
         * for the relaxed dev override that lets all paths through locally.
         *
         * To temporarily disable a rule in Production without redeploying, set an
         * environment variable that overrides this section. To add a new exclusion,
         * extend the expression with "or RequestPath like '/newpath%'".
         *
         * Expression syntax: https://github.com/serilog/serilog-expressions
         *   RequestPath   — the HTTP request path (set by UseSerilogRequestLogging)
         *   SourceContext — the fully-qualified class name of the ILogger<T>
         */
        "Filter": [
            {
                "Name": "ByExcluding",
                "Args": {
                    "expression": "RequestPath like '/health%' or RequestPath like '/favicon%' or RequestPath like '/cache/%' or SourceContext = 'Microsoft.AspNetCore.StaticFiles.StaticFileMiddleware'"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            "WithProcessId",
            "WithExceptionDetails"
        ]
    },

    /*
   * Logging section — retains the Email sub-keys used by the Serilog email
   * alert sink (LoggingConfiguration.cs reads Logging:Email:* at runtime).
   * The LogLevel block is superseded by the Serilog section above but is kept
   * so ASP.NET Core's built-in ILogger infrastructure has sensible defaults
   * if Serilog is ever removed.
   *
   * SECRETS — never commit real values here; use User Secrets (dev) or
   * environment variables (prod).
   *
   * User Secrets setup (run once per dev machine):
   *   dotnet user-secrets set "Logging:Email:SmtpHost"     "smtp.gmail.com"
   *   dotnet user-secrets set "Logging:Email:SmtpPort"     "587"
   *   dotnet user-secrets set "Logging:Email:SmtpUser"     "scrumflix@gmail.com"
   *   dotnet user-secrets set "Logging:Email:SmtpPassword" "<app-password>"
   *   dotnet user-secrets set "Logging:Email:From"         "scrumflix@gmail.com"
   *   dotnet user-secrets set "Logging:Email:To"           "scrumflix@gmail.com"
   *
   * If any key is missing the email sink is silently skipped at startup.
   */
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database": "Warning",
            "Microsoft.AspNetCore.StaticFiles": "Error",
            "System.Net.Http.HttpClient": "Warning"
        },
        "Email": {
            "SmtpHost": "",
            "SmtpPort": "587",
            "SmtpUser": "",
            "SmtpPassword": "",
            "From": "",
            "To": ""
        }
    },
    "Tmdb": {
        "ApiKey": ""
    },

    /*
   * Transactional email configuration (EmailService / IEmailService).
   * DISTINCT from the Serilog email alert sink (Logging:Email:*).
   * These keys control order confirmations, concession receipts, staff notifications,
   * and PDF delivery.
   *
   * Gmail app-password setup (one-time):
   *   1. Sign into scrumflix@gmail.com → Google Account → Security
   *   2. Enable 2-Step Verification if not already on.
   *   3. Go to Security → "App passwords" → generate a new password for "Mail".
   *   4. Copy the 16-character password (no spaces) — use it as SmtpPassword below.
   *
   * User Secrets setup (run once per dev machine from the ScrumFlix project folder):
   *   dotnet user-secrets set "Email:SmtpHost"     "smtp.gmail.com"
   *   dotnet user-secrets set "Email:SmtpPort"     "587"
   *   dotnet user-secrets set "Email:SmtpUser"     "scrumflix@gmail.com"
   *   dotnet user-secrets set "Email:SmtpPassword" "<16-char-app-password>"
   *   dotnet user-secrets set "Email:From"         "scrumflix@gmail.com"
   *   dotnet user-secrets set "Email:FromName"     "ScrumFlix"
   *   dotnet user-secrets set "Email:AdminTo"      "scrumflix@gmail.com"
   *
   * The values below are PLACEHOLDERS — the real secrets live only in User Secrets
   * (dev) or environment variables (prod). Never commit real credentials here.
   *
   * Missing keys → EmailService logs a warning and skips delivery silently.
   * Checkout is NEVER blocked by missing email configuration.
   */
    "Email": {
        "SmtpHost":     "",
        "SmtpPort":     "587",
        "SmtpUser":     "",
        "SmtpPassword": "",
        "From":         "",
        "FromName":     "ScrumFlix",
        "AdminTo":      ""
    },

    "AllowedHosts": "*"
}
