<Project Sdk="Microsoft.NET.Sdk.Web">

	<Target Name="ApplyWebConfigTransform" AfterTargets="Publish">
		<TransformXml Source="$(PublishDir)web.config"
				      Transform="web.Production.config"
				      Destination="$(PublishDir)web.config"
				      Condition="Exists('web.Production.config')" />
	</Target>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ScrumFlix</RootNamespace>
		<UseImageSharp>true</UseImageSharp>
		<UserSecretsId>scrumflix-cinema-secrets</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Web\**" />
		<Content Remove="Web\**" />
		<EmbeddedResource Remove="Web\**" />
		<None Remove="Web\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- ── HTMX — partial-page updates ──────────────────────────────────── -->
		<!--
		    Htmx 1.12.0 + Htmx.TagHelpers 1.12.0 — HTMX integration for ASP.NET Core.
		    Htmx provides the C# request/response helpers (IsHtmx, HtmxResponse, etc.).
		    Htmx.TagHelpers adds Razor tag helper support for hx-* attributes.
		    Used for Admin TMDb Sync Dashboard partial swaps, stat card refreshes,
		    and Staff Portal inline CRUD operations.
		-->
		<PackageReference Include="Htmx"              Version="1.12.0" />
		<PackageReference Include="Htmx.TagHelpers"   Version="1.12.0" />

		<!-- ── Authentication — password hashing ────────────────────────────── -->
		<!--
		    BCrypt.Net-Next 4.2.0 — BCrypt password hashing for .NET.
		    INTENTIONALLY RETAINED: Existing password hashes in the database are BCrypt.
		    Replacing the hasher would invalidate all stored PasswordHash values.
		    Used by AuthService for:
		      1. Verifying BCrypt-hashed passwords on login.
		      2. Migrating legacy plaintext UserPassword to PasswordHash on first login.
		      3. Hashing new passwords set via ChangePasswordAsync.
		    Work factor defaults to 11 (≈100 ms on modern hardware).
		-->
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />

		<!-- ── Email — SMTP client + MIME assembly ───────────────────────────── -->
		<!--
		    MailKit 4.17.0 — cross-platform SMTP client (no System.Net.Mail dependency).
		    MimeKit 4.17.0 — MIME message assembly; required by MailKit.
		    Used by EmailService (transactional email: order confirmations, receipts,
		    staff notifications) and by LoggingConfiguration (Serilog email alert sink).
		-->
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="MimeKit" Version="4.17.0" />

		<!-- ── Data access — EF Core + MySQL provider ────────────────────────── -->
		<!--
		    Microsoft.EntityFrameworkCore 9.0.15 — ORM core.
		    Microsoft.EntityFrameworkCore.Design 9.0.15 — design-time tools (migrations).
		    Pomelo.EntityFrameworkCore.MySql 9.0.0 — MySQL provider for EF Core.
		    INTENTIONALLY HELD AT 9.x: Pomelo 10.0.0 does not yet exist.
		    Do NOT upgrade to EF Core 10.x until a matching Pomelo release is available.
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore"        Version="9.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql"     Version="9.0.0" />

		<!-- ── HTTP resilience ───────────────────────────────────────────────── -->
		<!--
		    Microsoft.Extensions.Http.Resilience 10.6.0 — Polly-based retry, circuit-breaker,
		    and timeout policies for HttpClient. Used by TmdbConfiguration to configure
		    resilient HTTP calls to the TMDb API (retry on 5xx/429, exponential backoff).
		-->
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />

		<!-- ── Export — Excel + CSV streaming ───────────────────────────────── -->
		<!--
		    MiniExcel 1.44.1 — lightweight streaming Excel (.xlsx) and CSV writer/reader.
		    Replaces BOTH ClosedXML (Excel) and CsvHelper (CSV) — a single API handles
		    both formats via MiniExcel.SaveAs() with a configurable ExcelType parameter.
		    Uses streaming output to a MemoryStream; no font-measurement calls so safe
		    on Linux (Aiven/Docker). Used by AdminManageController ExportTickets and
		    ExportConcessions actions.
		-->
		<PackageReference Include="MiniExcel" Version="1.44.1" />

		<!-- ── Security headers ─────────────────────────────────────────────── -->
		<!--
		    NetEscapades.AspNetCore.SecurityHeaders 1.3.1 — adds HSTS, CSP,
		    X-Frame-Options, X-Content-Type-Options, Referrer-Policy,
		    Permissions-Policy, COOP, COEP, and CORP headers via fluent policy builder.
		    Configuration in Infrastructure/SecurityHeadersConfiguration.cs.
		-->
		<PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" Version="1.3.1" />

		<!-- ── PDF generation ────────────────────────────────────────────────── -->
		<!--
		    QuestPDF 2026.5.0 — fluent PDF generation library.
		    Used for staff pay stub PDFs and any other document generation features.
		    Community license covers open-source and internal-tool use.
		-->
		<PackageReference Include="QuestPDF" Version="2026.5.0" />

		<!-- ── QR code generation ────────────────────────────────────────────── -->
		<!--
		    QRCoder 1.8.0 — pure .NET QR code generator, no native dependencies.
		    Used by QrCodeService to encode structured payloads as Base64 PNG images:
		      • Ticket data (SCRUMFLIX|CODE:|MOVIE:|DATE:|TIME:|SEAT:|SCREEN:|LOCATION:)
		        for the ticket QR codes on the OrderConfirmation page.
		      • Concession order receipts (SCRUMFLIX-CONCESSIONS|ORDER:|DATE:|TIME:|items|TOTAL:)
		        as proof of pre-purchase shown at the concession stand.
		    PngByteQRCode renderer used throughout — no System.Drawing / GDI+ dependency,
		    safe on Linux (Aiven).
		-->
		<PackageReference Include="QRCoder" Version="1.8.0" />

		<!-- ── Serilog — structured logging pipeline ────────────────────────── -->
		<!--
		    Serilog.AspNetCore 10.0.0 — integrates Serilog with the ASP.NET Core
		    ILogger pipeline via builder.Services.AddSerilog() (modern .NET 8+ pattern).
		    Pulls in Serilog core and the Console sink.

		    Serilog.Sinks.MySQL 6.1.0 — writes structured log events to the Aiven MySQL
		    instance via a dedicated "Logs" table (auto-created on first startup).
		    EF Core does NOT own this table — keep DbSet<AppLog> commented out.

		    Serilog.Sinks.Email 4.2.1 — batched SMTP email alerts for Error+ events
		    via MailKit. Wrapped in a sub-logger (WriteTo.Logger) with an
		    expression filter (Serilog.Expressions) so only ScrumFlix-namespaced
		    errors trigger alerts — preventing framework noise email storms.

		    Serilog.Sinks.Async 2.1.0 — wraps MySQL and Email sinks so database
		    writes and SMTP calls never block the request pipeline thread.

		    Serilog.Enrichers.Environment / Thread / Process — attach MachineName,
		    ThreadId, ProcessId to every log event for distributed-system tracing.

		    Serilog.Expressions 5.0.0 — expression-based filtering and templating:
		      1. Global Filter.ByExcluding() — suppresses health-check, favicon,
		         static-asset, and /cache/ noise before events reach any sink.
		      2. ExpressionTemplate on the Console sink — conditional CorrelationId
		         and exception rendering using the {@t}/{@l}/{@m}/{@x} notation.
		      3. Sub-logger ByIncludingOnly() on the Email sink — scopes email alerts
		         to ScrumFlix Error/Fatal SourceContext events only.

		    Serilog.Exceptions 8.4.0 — structured exception enrichment.
		    Adds WithExceptionDetails() to capture inner exceptions, data dictionary,
		    and custom exception properties as structured Serilog properties rather
		    than flattened strings. Required by LoggingConfiguration.cs.
		-->
		<PackageReference Include="Serilog.AspNetCore"             Version="10.0.0" />
		<PackageReference Include="Serilog.Enrichers.Environment"  Version="3.0.1" />
		<PackageReference Include="Serilog.Enrichers.Process"      Version="3.0.0" />
		<PackageReference Include="Serilog.Enrichers.Thread"       Version="4.0.0" />
		<PackageReference Include="Serilog.Exceptions"             Version="8.4.0" />
		<PackageReference Include="Serilog.Expressions"            Version="5.0.0" />
		<PackageReference Include="Serilog.Sinks.Async"            Version="2.1.0" />
		<PackageReference Include="Serilog.Sinks.Email"            Version="4.2.1" />
		<PackageReference Include="Serilog.Sinks.MySQL"            Version="6.1.0" />

		<!-- ── Image processing — SixLabors ─────────────────────────────────── -->
		<!--
		    SixLabors.ImageSharp 4.0.0 — cross-platform image processing (no GDI+).
		    SixLabors.ImageSharp.Web 4.0.0 — middleware for on-demand image resizing
		    and caching (movie poster thumbnails, /cache/ route).
		    SixLabors.ImageSharp.Drawing 3.0.0 — drawing API for text-on-image
		    and custom graphics operations.
		    SixLabors.Fonts 3.0.0 — font loading for ImageSharp.Drawing text rendering.
		    Direct dependency — kept as explicit reference.
		    All four versions are intentionally pinned together for ABI compatibility.
		-->
		<PackageReference Include="SixLabors.Fonts"          Version="3.0.0" />
		<PackageReference Include="SixLabors.ImageSharp"     Version="4.0.0" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.0.0" />
		<PackageReference Include="SixLabors.ImageSharp.Web" Version="4.0.0" />

		<!-- ── TMDb integration ──────────────────────────────────────────────── -->
		<!--
		    TMDbLib 3.0.0 — .NET client for The Movie Database (TMDb) REST API.
		    Used by TmdbSyncService to fetch movie metadata, genre lists, and poster
		    paths for the Admin TMDb Sync Dashboard.
		-->
		<PackageReference Include="TMDbLib" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ViewComponents\" />
		<Folder Include="Views\Shared\Components\FooterLocations\" />
		<Folder Include="wwwroot\cache\tmdb\" />
	</ItemGroup>

</Project>
