{
  /*
   * appsettings.Development.json — local development overrides.
   *
   * These values override appsettings.json when ASPNETCORE_ENVIRONMENT=Development.
   * Real secrets still go in User Secrets, not here.
   *
   * The Serilog section overrides the production baseline in appsettings.json:
   * - Default drops to Debug so all ScrumFlix code is visible in dev.
   * - Microsoft.EntityFrameworkCore.Database.Command raised to Information so
   *   generated SQL is visible in the console without EF noise everywhere else.
   * - Microsoft raised to Information (not Warning) for richer startup diagnostics.
   */
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft":                                        "Information",
        "Microsoft.Hosting.Lifetime":                       "Information",
        "Microsoft.EntityFrameworkCore":                    "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command":   "Information",
        "Microsoft.AspNetCore.StaticFiles":                 "Error",
        "System.Net.Http.HttpClient":                       "Warning",
        "ScrumFlix":                                        "Debug"
      }
    },
    /*
     * Dev filter override — passes ALL events through so nothing is hidden
     * during local development. The production filter in appsettings.json
     * excludes health/favicon/cache requests; in dev you want to see them.
     *
     * "true" is a valid Serilog.Expressions expression meaning "include everything".
     * This overrides (replaces, not merges) the production ByExcluding rule.
     */
    "Filter": [
      {
        "Name": "ByIncludingOnly",
        "Args": { "expression": "true" }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default":                                       "Debug",
      "Microsoft":                                     "Information",
      "Microsoft.Hosting.Lifetime":                    "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "ScrumFlix":                                     "Debug"
    }
  }
}
