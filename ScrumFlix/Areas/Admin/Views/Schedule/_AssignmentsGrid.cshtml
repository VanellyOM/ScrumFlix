@*
 * Partial: _AssignmentsGrid.cshtml
 * Swapped by HTMX and by SignalR AssignmentsUpdated event.
 *@
@model List<ScrumFlix.Areas.Admin.ViewModels.AssignmentRowViewModel>

@if (!Model.Any())
{
    <p class="sf-text-muted mt-3">No assignments yet. Add one using the form.</p>
}
else
{
    <div class="sf-admin-table-wrap">
    <div class="table-responsive">
        <table class="table sf-admin-table" aria-label="Schedule Assignments">
            <thead>
                <tr>
                    <th scope="col">Assignment</th>
                    <th scope="col">Employee</th>
                    <th scope="col">Role</th>
                    <th scope="col">Location</th>
                    <th scope="col">Shift</th>
                    <th scope="col">Showtime</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr hx-get="/Admin/Schedule/GetAssignment/@a.AssignmentId"
                        hx-target="#assignment-form-container"
                        hx-trigger="click"
                        style="cursor:pointer;"
                        title="Click to edit">
                        <td>@a.AssignmentName</td>
                        <td>@a.EmployeeName</td>
                        <td>@a.RoleName</td>
                        <td>@a.LocationName</td>
                        <td>@a.StartTime.ToString("MM/dd h:mm tt") – @a.EndTime.ToString("h:mm tt")</td>
                        <td>@a.ShowtimeTitle</td>
                        <td class="text-end" onclick="event.stopPropagation()">
                            <form method="post" action="/Admin/Schedule/DeleteAssignment"
                                  onsubmit="return confirm('Delete this assignment?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="assignmentId" value="@a.AssignmentId" />
                                <button type="submit" class="btn btn-sm sf-btn-danger">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
}
