@model ScrumFlix.Areas.Admin.ViewModels.LocationIndexViewModel
@{
    ViewData["Title"] = "Manage Locations";

}

<div class="sf-page-header">
    <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="sf-page-title"><i class="bi bi-geo-alt me-2"></i>Theater Locations</h1>
            <p class="sf-page-subtitle">Manage cinema locations and their screens</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="AdminManage" asp-action="Screens" class="btn sf-btn-outline">
                <i class="bi bi-display me-2"></i>Screens
            </a>
            <a asp-area="Admin" asp-controller="AdminManage" asp-action="LocationCreate" class="btn sf-btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Add Location
            </a>
        </div>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="sf-flash-banner sf-flash-banner--success d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0"></i><span>@ok</span>
            </div>
        }

        @if (!Model.Locations.Any())
        {
            <div class="sf-empty-state text-center py-5">
                <i class="bi bi-geo sf-empty-icon"></i>
                <p class="sf-text-muted mt-3">No locations yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table sf-admin-table" aria-label="Locations">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Address</th>
                            <th scope="col" class="text-end">Screens</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loc in Model.Locations)
                        {
                            <tr class="@(!loc.IsActive ? "opacity-50" : "")">
                                <td class="fw-500">@loc.LocationName</td>
                                <td class="sf-text-muted">@(loc.LocationAddress ?? "—")</td>
                                <td class="text-end">@loc.TheaterScreens.Count</td>
                                <td>
                                    @if (loc.IsActive)
                                    {
                                        <span class="badge sf-badge-ok">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge sf-badge-oos">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-area="Admin" asp-controller="AdminManage" asp-action="LocationEdit"
                                           asp-route-id="@loc.LocationId" class="btn btn-sm sf-btn-outline" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="AdminManage" asp-action="Screens"
                                           asp-route-locationId="@loc.LocationId" class="btn btn-sm sf-btn-ghost" title="View screens">
                                            <i class="bi bi-display"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</section>
