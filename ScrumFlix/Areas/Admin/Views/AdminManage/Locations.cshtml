@model ScrumFlix.Areas.Admin.ViewModels.LocationIndexViewModel
@{
    ViewData["Title"] = "Manage Locations";
}

<div class="sf-page-header">
    <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="sf-page-title"><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>Theater Locations</h1>
            <p class="sf-page-subtitle">Manage cinema locations and their screens</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="AdminManage" asp-action="Screens" class="btn sf-btn-outline">
                <i class="bi bi-display me-2" aria-hidden="true"></i>Screens
            </a>
            <a asp-area="Admin" asp-controller="AdminManage" asp-action="LocationCreate" class="btn sf-btn-primary">
                <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Location
            </a>
        </div>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="sf-flash-banner sf-flash-banner--success d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@ok</span>
            </div>
        }

        @if (!Model.Locations.Any())
        {
            <div class="sf-empty-state text-center py-5">
                <i class="bi bi-geo sf-empty-icon" aria-hidden="true"></i>
                <p class="sf-text-muted mt-3">No locations yet.</p>
            </div>
        }
        else
        {
            <div class="sf-admin-table-wrap">
            <div class="table-responsive">
                <table class="table sf-admin-table" id="locations-table" aria-label="Theater locations">
                    <caption class="visually-hidden">Theater locations — @Model.Locations.Count record(s)</caption>
                    <thead>
                        <tr>
                            <th scope="col" data-sort-col="0" style="cursor:pointer">
                                Name <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col">Address</th>
                            <th scope="col" class="text-end" data-sort-col="2" style="cursor:pointer">
                                Screens <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col">Time Zone</th>
                            <th scope="col" data-sort-col="4" style="cursor:pointer">
                                Status <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loc in Model.Locations)
                        {
                            <tr class="@(!loc.IsActive ? "opacity-50" : "")">
                                <td class="fw-500">@loc.LocationName</td>
                                <td class="sf-text-muted">@(loc.LocationAddress ?? "—")</td>
                                <td class="text-end">@loc.TheaterScreens.Count</td>
                                <td class="sf-text-muted" style="font-size:.85rem">@(loc.TimeZoneId ?? "—")</td>
                                <td>
                                    @if (loc.IsActive)
                                    {
                                        <span class="badge sf-badge-ok">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge sf-badge-oos">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-area="Admin" asp-controller="AdminManage" asp-action="LocationEdit"
                                           asp-route-id="@loc.LocationId"
                                           class="btn btn-sm sf-btn-outline"
                                           title="Edit @loc.LocationName">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="AdminManage" asp-action="Screens"
                                           asp-route-locationId="@loc.LocationId"
                                           class="btn btn-sm sf-btn-ghost"
                                           title="View screens for @loc.LocationName">
                                            <i class="bi bi-display" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
            <p class="sf-text-muted mt-2" style="font-size:.8rem">
                @Model.Locations.Count location(s)
            </p>
        }

    </div>
</section>

@section Scripts {
<script src="~/js/sf-admin-tables.js"></script>
<script>
    // Wire data-sort-col headers — keeps onclick out of markup for CSP compliance.
    document.querySelectorAll('th[data-sort-col]').forEach(th => {
        th.addEventListener('click', () =>
            sortTable('locations-table', parseInt(th.dataset.sortCol, 10)));
    });
</script>
}
