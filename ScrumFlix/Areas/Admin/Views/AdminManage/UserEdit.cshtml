@model ScrumFlix.Areas.Admin.ViewModels.UserFormViewModel
@{
    ViewData["Title"] = "Edit User — " + Model.UserName;
}

<div class="sf-page-header">
    <div class="container-xl">
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="Users"
           class="sf-back-link mb-2 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Users
        </a>
        <h1 class="sf-page-title">
            <i class="bi bi-person-gear me-2" aria-hidden="true"></i>Edit — @Model.UserName
        </h1>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="sf-form-card">
                    <form asp-area="Admin" asp-controller="AdminManage" asp-action="UserEdit"
                          method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="UserId" type="hidden" />
                        <div asp-validation-summary="ModelOnly"
                             class="sf-flash-banner sf-flash-banner--error mb-4" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="sf-label"></label>
                            <input asp-for="UserName" class="sf-input"
                                   autocomplete="username" maxlength="50" />
                            <span asp-validation-for="UserName" class="sf-validation"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RoleId" class="sf-label"></label>
                            <select asp-for="RoleId" class="sf-select">
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.RoleId"
                                            selected="@(Model.RoleId == role.RoleId)">
                                        @role.RoleName
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="RoleId" class="sf-validation"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" type="checkbox"
                                       class="form-check-input" role="switch"
                                       id="IsActiveToggle" />
                                <label class="form-check-label sf-label mb-0" for="IsActiveToggle">
                                    Active — can sign in to the Staff Portal
                                </label>
                            </div>
                            <span asp-validation-for="IsActive" class="sf-validation"></span>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="MustChangePassword" type="checkbox"
                                       class="form-check-input" role="switch"
                                       id="MustChangePwToggle" />
                                <label class="form-check-label sf-label mb-0" for="MustChangePwToggle">
                                    Require password change on next login
                                </label>
                            </div>
                            <span asp-validation-for="MustChangePassword" class="sf-validation"></span>
                        </div>

                        <hr class="sf-divider mb-4" />

                        <p class="sf-text-muted mb-3" style="font-size:.875rem">
                            <i class="bi bi-key me-1" aria-hidden="true"></i>
                            <strong>Reset Password</strong> — leave both fields blank to keep the current password.
                        </p>

                        <div class="mb-3">
                            <label asp-for="Password" class="sf-label"></label>
                            <input asp-for="Password" type="password" class="sf-input"
                                   placeholder="New password (min 6 chars)"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password" class="sf-validation"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="sf-label"></label>
                            <input asp-for="ConfirmPassword" type="password" class="sf-input"
                                   placeholder="Re-enter new password"
                                   autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="sf-validation"></span>
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn sf-btn-primary flex-grow-1">
                                <i class="bi bi-save me-2" aria-hidden="true"></i>Save Changes
                            </button>
                            <a asp-area="Admin" asp-controller="AdminManage" asp-action="Users"
                               class="btn sf-btn-ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
