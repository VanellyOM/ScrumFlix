@model ScrumFlix.Areas.Admin.ViewModels.ConcessionIndexViewModel
@{
    ViewData["Title"] = "Manage Concessions";

}

<div class="sf-page-header">
    <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="sf-page-title"><i class="bi bi-cup-straw me-2" aria-hidden="true"></i>Concession Items</h1>
            <p class="sf-page-subtitle">Manage inventory and pricing</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="ConcessionCreate" class="btn sf-btn-primary">
            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Item
        </a>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="sf-flash-banner sf-flash-banner--success d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0"></i><span>@ok</span>
            </div>
        }

        @if (Model.LowStockCount > 0)
        {
            <div class="sf-flash-banner sf-flash-banner--warning d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <span><strong>@Model.LowStockCount item(s)</strong> are at or below minimum stock.</span>
            </div>
        }

        <div class="d-flex flex-wrap gap-3 mb-4 align-items-end">
            <form asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions" method="get" class="d-flex gap-2 flex-wrap align-items-end">
                <div>
                    <label class="sf-label mb-1">Filter by location</label>
                    <select name="locationId" class="sf-select" style="min-width:160px">
                        <option value="">All locations</option>
                        @foreach (var l in Model.Locations)
                        {
                            <option value="@l.LocationId" selected="@(Model.FilterLocationId == l.LocationId)">@l.LocationName</option>
                        }
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" id="showInactive" name="showInactive" value="true" @(Model.ShowInactive ? "checked" : "") class="form-check-input" />
                    <label for="showInactive" class="sf-label mb-0">Show inactive</label>
                </div>
                <button type="submit" class="btn sf-btn-outline"><i class="bi bi-funnel me-1"></i>Filter</button>
            </form>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="sf-empty-state text-center py-5">
                <i class="bi bi-cup sf-empty-icon"></i>
                <p class="sf-text-muted mt-3">No concession items found.</p>
            </div>
        }
        else
        {
            <div class="sf-admin-table-wrap">
            <div class="table-responsive">
                <table class="table sf-admin-table" aria-label="Concession items">
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Location</th>
                            <th scope="col" class="text-end">Price</th>
                            <th scope="col" class="text-end">In Stock</th>
                            <th scope="col" class="text-end">Min</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items.OrderBy(i => i.QuantityInStock))
                        {
                            var isLow = item.IsLowStock;
                            <tr class="@(!item.IsActive ? "opacity-50" : isLow ? "sf-row-warning" : "")">
                                <td class="fw-500">@item.ItemName</td>
                                <td>@(item.Location?.LocationName ?? "—")</td>
                                <td class="text-end">@item.Price.ToString("C")</td>
                                <td class="text-end @(isLow ? "text-danger fw-500" : "")">@item.QuantityInStock</td>
                                <td class="text-end">@item.Minimum</td>
                                <td>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge sf-badge-oos">Inactive</span>
                                    }
                                    else if (item.QuantityInStock <= 0)
                                    {
                                        <span class="badge sf-badge-oos">Out of Stock</span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge sf-badge-low-stock"><i class="bi bi-exclamation-triangle-fill me-1"></i>Low</span>
                                    }
                                    else
                                    {
                                        <span class="badge sf-badge-ok">OK</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-area="Admin" asp-controller="AdminManage" asp-action="ConcessionEdit"
                                           asp-route-id="@item.ConcessionItemId" class="btn btn-sm sf-btn-outline" title="Edit">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="AdminManage" asp-action="ConcessionRestock"
                                           asp-route-id="@item.ConcessionItemId" class="btn btn-sm sf-btn-ghost" title="Restock">
                                            <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        }

    </div>
</section>
