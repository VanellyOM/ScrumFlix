@*
 * File: /ScrumFlix/Areas/Admin/Views/AdminManage/StaffPortalTest.cshtml
 * Description: Staff Portal Test Page.
 *
 *   PURPOSE:
 *     Proves that movie edits and concession restock operations are "live" and
 *     routed through the staff session — not the web.sales (WebUser) identity.
 *     Duplicates the data displayed in the customer Movies tab and Concessions tab,
 *     but every action link goes to an Admin area action, not to the customer portal.
 *
 *   IDENTITY PROOF:
 *     The page header shows the authenticated staff user name and role drawn directly
 *     from the session (CurrentUserId / CurrentUserName / CurrentRoleId in the controller),
 *     confirming that the web.sales entity is NOT in use for this session.
 *
 *   LINKS:
 *     ALL links stay inside /Admin/AdminManage/* — zero customer portal crossover.
 *     Movies panel → AdminManage/Concessions (Restock) or AdminManage/ConcessionEdit
 *     (Note: Movie CRUD lives in MoviesController but is guarded by StaffGuard(Manager+).
 *      Direct Admin-area Movie edit links are wired to /Movies/MovieEdit with StaffGuard.)
 *
 *   MANAGER ACCESS:
 *     RoleGuard(2) — both Admin and Manager can reach this page.
 *@
@model ScrumFlix.Areas.Admin.ViewModels.StaffPortalTestViewModel
@using ScrumFlix.Areas.Admin.ViewModels
@{
    ViewData["Title"] = "Staff Portal Test";

}

@* ── Page header ──────────────────────────────────────────────────────────── *@
<div class="sf-page-header">
    <div class="container-xl">
        <h1 class="sf-page-title">
            <i class="bi bi-display-fill me-2 text-warning" aria-hidden="true"></i>Staff Portal Test Page
        </h1>
        <p class="sf-page-subtitle">
            Verifies that movie and concession data is live and routed through the staff session —
            not the web.sales (WebUser) identity.
        </p>
    </div>
</div>

<div class="container-xl py-4">

    @* Back to dashboard *@
    <a asp-area="Admin" asp-controller="AdminHome" asp-action="AdminDashboard"
       class="sf-back-link mb-4 d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Admin Dashboard
    </a>

    @* Flash messages *@
    @if (TempData["SuccessMessage"] is string ok)
    {
        <div class="sf-flash-banner sf-flash-banner--success d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@ok</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string err)
    {
        <div class="sf-flash-banner sf-flash-banner--danger d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-x-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@err</span>
        </div>
    }

    @* ── Identity Banner ────────────────────────────────────────────────── *@
    <section aria-labelledby="identity-heading" class="mb-4">
        <div class="card sf-card p-4 border border-warning border-opacity-50">
            <h2 id="identity-heading" class="h5 mb-3">
                <i class="bi bi-shield-check me-2 text-warning" aria-hidden="true"></i>
                Active Session Identity
            </h2>
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="sf-stat-card">
                        <i class="bi bi-person-badge sf-stat-icon" aria-hidden="true"></i>
                        <div class="sf-stat-value" style="font-size:1.2rem;">@Model.StaffUserName</div>
                        <div class="sf-stat-label">Logged-In User</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="sf-stat-card">
                        <i class="bi bi-key-fill sf-stat-icon" aria-hidden="true"></i>
                        <div class="sf-stat-value" style="font-size:1.2rem;">@Model.StaffRole</div>
                        <div class="sf-stat-label">Role</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="sf-stat-card">
                        <i class="bi bi-hash sf-stat-icon" aria-hidden="true"></i>
                        <div class="sf-stat-value" style="font-size:1.2rem;">@Model.StaffUserId</div>
                        <div class="sf-stat-label">UserId (not web.sales)</div>
                    </div>
                </div>
            </div>
            <p class="sf-text-muted mb-0 mt-3" style="font-size:0.85rem;">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                All edits below are attributed to <strong>@Model.StaffUserName</strong> (UserId&nbsp;@Model.StaffUserId)
                in Serilog logs and AuditLog entries — the <code>web.sales</code> WebUser is NOT active for this session.
            </p>
        </div>
    </section>

    @* ════════════════════════════════════════════════════════════════════════
         PANEL 1 — MOVIES  (mirrors customer Movies tab)
    ════════════════════════════════════════════════════════════════════════ *@
    <section aria-labelledby="movies-heading" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h2 id="movies-heading" class="sf-section-title mb-0">
                <span class="sf-gold-bar" aria-hidden="true"></span>
                Movies Catalog
                <span class="badge bg-secondary ms-2" style="font-size:0.75rem;">@Model.Movies.Count titles</span>
            </h2>
            @* Admin-only: add movie link *@
            <a asp-area="" asp-controller="Movies" asp-action="MovieCreate" class="btn sf-btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Movie
            </a>
        </div>
        <p class="sf-text-muted mb-3" style="font-size:0.85rem;">
            Same data as the customer Movies tab. Edit/delete actions use the staff session
            and are guarded by <code>StaffGuard(Manager+)</code>.
        </p>

        @if (!Model.Movies.Any())
        {
            <div class="sf-flash-banner sf-flash-banner--info" role="status">No movies in the catalog yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table sf-admin-table" aria-label="Movies catalog test">
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Rating</th>
                            <th scope="col">Genre</th>
                            <th scope="col">Runtime</th>
                            <th scope="col">Poster</th>
                            <th scope="col">TMDB</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Movies)
                        {
                            var hasTmdb    = m.TmdbMetadata != null;
                            var posterPath = m.TmdbMetadata?.PosterPath;
                            <tr>
                                <td>
                                    <strong>@m.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(m.Description))
                                    {
                                        <br /><small class="sf-text-muted">@(m.Description.Length > 80 ? m.Description[..80] + "…" : m.Description)</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@m.Rating</span></td>
                                <td>@m.Genre</td>
                                <td>@m.RuntimeMinutes min</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(posterPath))
                                    {
                                        <img src="https://image.tmdb.org/t/p/w92@posterPath"
                                             alt="@m.Title poster"
                                             style="height:48px;border-radius:3px;object-fit:cover;"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="sf-text-muted" style="font-size:0.8rem;">—</span>
                                    }
                                </td>
                                <td>
                                    @if (hasTmdb)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="TMDB synced" aria-label="Synced"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-danger" title="Not synced" aria-label="Not synced"></i>
                                    }
                                </td>
                                <td class="text-end">
                                    @* Edit links to MoviesController (guarded by StaffGuard) — not the customer portal *@
                                    <a asp-area="" asp-controller="Movies" asp-action="MovieEdit"
                                       asp-route-id="@m.MovieId"
                                       class="btn btn-sm sf-btn-secondary me-1"
                                       title="Edit '@m.Title'">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <form asp-area="" asp-controller="Movies" asp-action="MovieDelete"
                                          method="post" style="display:inline;"
                                          onsubmit="return confirm('Permanently delete \'@m.Title\'? This cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.MovieId" />
                                        <button type="submit" class="btn btn-sm sf-btn-danger"
                                                title="Delete '@m.Title'">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ════════════════════════════════════════════════════════════════════════
         PANEL 2 — CONCESSIONS  (mirrors customer Concessions tab)
    ════════════════════════════════════════════════════════════════════════ *@
    <section aria-labelledby="conc-heading">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h2 id="conc-heading" class="sf-section-title mb-0">
                <span class="sf-gold-bar" aria-hidden="true"></span>
                Concessions Catalog
                <span class="badge bg-secondary ms-2" style="font-size:0.75rem;">@Model.ConcessionItems.Count items</span>
                @if (Model.HasLowStockItems)
                {
                    <span class="badge bg-warning text-dark ms-1" style="font-size:0.75rem;">
                        <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>@Model.LowStockCount low stock
                    </span>
                }
            </h2>
            <a asp-area="Admin" asp-controller="AdminManage" asp-action="ConcessionCreate"
               class="btn sf-btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Item
            </a>
        </div>
        <p class="sf-text-muted mb-3" style="font-size:0.85rem;">
            Same data as the customer Concessions tab. Restock and edit links go to the Admin area
            (<code>/Admin/AdminManage/*</code>) and use the staff session — not the WebUser.
        </p>

        @if (Model.HasLowStockItems)
        {
            <div class="sf-flash-banner sf-flash-banner--warning d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
                <span>
                    <strong>@Model.LowStockCount item(s) are at or below minimum stock.</strong>
                    Use the Restock button to add inventory.
                </span>
            </div>
        }

        @if (!Model.ConcessionItems.Any())
        {
            <div class="sf-flash-banner sf-flash-banner--info" role="status">No active concession items.</div>
        }
        else
        {
            <div class="row g-3 mb-4">
                @foreach (var ci in Model.ConcessionItems)
                {
                    var isLow = ci.IsLowStock;
                    var isOut = ci.QuantityInStock <= 0;
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="card sf-card h-100 @(isOut ? "border border-danger border-opacity-50" : isLow ? "border border-warning border-opacity-50" : "")">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="h6 mb-0">@ci.ItemName</h3>
                                    @if (isOut)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Low
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">In Stock</span>
                                    }
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="sf-stat-label">Price</div>
                                        <div class="fw-semibold">@ci.Price.ToString("C")</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="sf-stat-label">Stock</div>
                                        <div class="fw-semibold @(isLow ? "text-warning" : "")">
                                            @ci.QuantityInStock <small class="sf-text-muted">/ min @ci.Minimum</small>
                                        </div>
                                    </div>
                                    @if (ci.Location != null)
                                    {
                                        <div class="col-12">
                                            <div class="sf-stat-label">Location</div>
                                            <div style="font-size:0.85rem;">@ci.Location.LocationName</div>
                                        </div>
                                    }
                                </div>

                                @* ALL buttons stay inside Admin area *@
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-area="Admin" asp-controller="AdminManage"
                                       asp-action="ConcessionRestock"
                                       asp-route-id="@ci.ConcessionItemId"
                                       class="btn btn-sm sf-btn-primary">
                                        <i class="bi bi-arrow-up-circle me-1" aria-hidden="true"></i>Restock
                                    </a>
                                    <a asp-area="Admin" asp-controller="AdminManage"
                                       asp-action="ConcessionEdit"
                                       asp-route-id="@ci.ConcessionItemId"
                                       class="btn btn-sm sf-btn-secondary">
                                        <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Tabular summary matching the customer catalog exactly *@
            <h3 class="h6 sf-text-muted mb-2">Tabular View (mirrors customer Concessions tab data)</h3>
            <div class="table-responsive">
                <table class="table sf-admin-table" aria-label="Concessions test tabular">
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col" class="text-end">Price</th>
                            <th scope="col" class="text-end">In Stock</th>
                            <th scope="col" class="text-end">Min</th>
                            <th scope="col">Location</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Actions (Admin)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ci in Model.ConcessionItems.OrderBy(i => i.QuantityInStock))
                        {
                            var isLow = ci.IsLowStock;
                            var isOut = ci.QuantityInStock <= 0;
                            <tr class="@(isLow ? "sf-row-warning" : "")">
                                <td><strong>@ci.ItemName</strong></td>
                                <td class="text-end">@ci.Price.ToString("C")</td>
                                <td class="text-end @(isLow ? "text-warning fw-bold" : "")">@ci.QuantityInStock</td>
                                <td class="text-end">@ci.Minimum</td>
                                <td>@(ci.Location?.LocationName ?? "—")</td>
                                <td>
                                    @if (isOut)
                                    {
                                        <span class="sf-badge-oos">Out of Stock</span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge sf-badge-low-stock">
                                            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Low
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge sf-badge-ok">OK</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="AdminManage"
                                       asp-action="ConcessionRestock"
                                       asp-route-id="@ci.ConcessionItemId"
                                       class="btn btn-sm sf-btn-primary me-1">
                                        <i class="bi bi-arrow-up-circle" aria-hidden="true"></i>
                                    </a>
                                    <a asp-area="Admin" asp-controller="AdminManage"
                                       asp-action="ConcessionEdit"
                                       asp-route-id="@ci.ConcessionItemId"
                                       class="btn btn-sm sf-btn-secondary">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>
