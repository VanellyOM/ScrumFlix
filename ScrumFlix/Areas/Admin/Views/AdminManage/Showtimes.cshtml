@model ScrumFlix.Areas.Admin.ViewModels.ShowtimeIndexViewModel
@{
    ViewData["Title"] = "Manage Showtimes";

    // Builds a sort link that toggles direction on the active column, resets to page 1,
    // and preserves all active filter values.
    string SortLink(string col) {
        var desc = Model.SortBy == col && !Model.SortDesc;
        return Url.Action("Showtimes", "AdminManage", new { area = "Admin",
            movieId    = Model.FilterMovieId,
            locationId = Model.FilterLocationId,
            status     = Model.FilterStatusActive.HasValue
                             ? (Model.FilterStatusActive.Value ? "active" : "inactive")
                             : null,
            sortBy = col, sortDesc = desc, page = 1 })!;
    }
    string SortIcon(string col) => Model.SortBy != col ? "bi-arrow-down-up text-muted"
        : (Model.SortDesc ? "bi-sort-down" : "bi-sort-up");

    // Builds pagination / sort-toggle URLs preserving all filters.
    string PageLink(int p) => Url.Action("Showtimes", "AdminManage", new { area = "Admin",
        movieId    = Model.FilterMovieId,
        locationId = Model.FilterLocationId,
        status     = Model.FilterStatusActive.HasValue
                         ? (Model.FilterStatusActive.Value ? "active" : "inactive")
                         : null,
        sortBy = Model.SortBy, sortDesc = Model.SortDesc, page = p })!;

    // Determine the value to pre-select in the status dropdown.
    string statusValue = Model.FilterStatusActive.HasValue
        ? (Model.FilterStatusActive.Value ? "active" : "inactive")
        : "";

    bool hasActiveFilter = Model.FilterMovieId.HasValue
        || Model.FilterLocationId.HasValue
        || Model.FilterStatusActive.HasValue;
}

<div class="sf-page-header">
    <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="sf-page-title">
                <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>Showtimes
            </h1>
            <p class="sf-page-subtitle">Schedule and manage cinema screenings</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="ShowtimeCreate"
           class="btn sf-btn-primary">
            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Showtime
        </a>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="sf-flash-banner sf-flash-banner--success d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@ok</span>
            </div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="sf-flash-banner sf-flash-banner--danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-x-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@err</span>
            </div>
        }

        <form asp-area="Admin" asp-controller="AdminManage" asp-action="Showtimes"
              method="get" class="d-flex flex-wrap gap-2 mb-4 align-items-end">
            @* Hidden fields preserve sort state when the filter form is submitted *@
            <input type="hidden" name="sortBy"   value="@Model.SortBy" />
            <input type="hidden" name="sortDesc" value="@Model.SortDesc" />

            <div>
                <label class="sf-label mb-1">Movie</label>
                <select name="movieId" class="sf-select sf-select--md">
                    <option value="">All movies</option>
                    @foreach (var m in Model.Movies)
                    {
                        <option value="@m.MovieId" selected="@(Model.FilterMovieId == m.MovieId)">
                            @m.Title
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="sf-label mb-1">Location</label>
                <select name="locationId" class="sf-select sf-select--md">
                    <option value="">All locations</option>
                    @foreach (var l in Model.Locations)
                    {
                        <option value="@l.LocationId" selected="@(Model.FilterLocationId == l.LocationId)">
                            @l.LocationName
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="sf-label mb-1">Status</label>
                <select name="status" class="sf-select sf-select--md">
                    <option value=""      selected="@(statusValue == "")">All</option>
                    <option value="active"   selected="@(statusValue == "active")">Active</option>
                    <option value="inactive" selected="@(statusValue == "inactive")">Inactive</option>
                </select>
            </div>

            <div class="d-flex gap-2 align-self-end">
                <button type="submit" class="btn sf-btn-outline">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filter
                </button>
                @if (hasActiveFilter)
                {
                    <a asp-area="Admin" asp-controller="AdminManage" asp-action="Showtimes"
                       class="btn sf-btn-ghost">Clear</a>
                }
            </div>
        </form>

        @if (!Model.Showtimes.Any())
        {
            <div class="sf-empty-state text-center py-5">
                <i class="bi bi-calendar-x sf-empty-icon" aria-hidden="true"></i>
                <p class="sf-text-muted mt-3">No showtimes found.</p>
                <a asp-area="Admin" asp-controller="AdminManage" asp-action="ShowtimeCreate"
                   class="btn sf-btn-primary mt-2">Schedule one</a>
            </div>
        }
        else
        {
            <div class="sf-admin-table-wrap">
            <div class="table-responsive">
                <table class="table sf-admin-table" aria-label="Showtimes">
                    <caption class="visually-hidden">
                        Showtimes — Page @Model.Page of @Model.TotalPages · @Model.TotalCount record(s)
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">
                                <a href="@SortLink("movie")" class="text-decoration-none sf-sort-header">
                                    Movie <i class="bi @SortIcon("movie") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="@SortLink("screen")" class="text-decoration-none sf-sort-header">
                                    Screen <i class="bi @SortIcon("screen") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="@SortLink("location")" class="text-decoration-none sf-sort-header">
                                    Location <i class="bi @SortIcon("location") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="@SortLink("start")" class="text-decoration-none sf-sort-header">
                                    Start Time <i class="bi @SortIcon("start") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-end">
                                <a href="@SortLink("price")" class="text-decoration-none sf-sort-header">
                                    Price <i class="bi @SortIcon("price") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-end">
                                <a href="@SortLink("capacity")" class="text-decoration-none sf-sort-header">
                                    Seats <i class="bi @SortIcon("capacity") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="@SortLink("status")" class="text-decoration-none sf-sort-header">
                                    Status <i class="bi @SortIcon("status") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var st in Model.Showtimes)
                        {
                            <tr class="@(!st.IsActive ? "opacity-50" : "")">
                                <td class="fw-500">@st.MovieTitle</td>
                                <td>@st.ScreenName</td>
                                <td>@st.LocationName</td>
                                <td>@st.StartTimeDisplay</td>
                                <td class="text-end">@st.PricePerTicket.ToString("C")</td>
                                <td class="text-end">@st.AvailableSeats / @st.Capacity</td>
                                <td>
                                    @if (st.IsActive) { <span class="badge sf-badge-ok">Active</span> }
                                    else { <span class="badge sf-badge-oos">Inactive</span> }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-area="Admin" asp-controller="AdminManage"
                                           asp-action="ShowtimeEdit"
                                           asp-route-id="@st.ShowtimeId"
                                           class="btn btn-sm sf-btn-outline"
                                           title="Edit showtime">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="AdminManage"
                                              asp-action="ShowtimeToggle" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@st.ShowtimeId" />
                                            <button type="submit" class="btn btn-sm sf-btn-ghost"
                                                    title="@(st.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(st.IsActive ? "bi-pause-circle" : "bi-play-circle")"
                                                   aria-hidden="true"></i>
                                            </button>
                                        </form>
                                        @if (st.TicketsSold == 0)
                                        {
                                            <form asp-area="Admin" asp-controller="AdminManage"
                                                  asp-action="ShowtimeDelete" method="post"
                                                  data-confirm="Delete this showtime? This cannot be undone."
                                                  class="sf-confirm-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@st.ShowtimeId" />
                                                <button type="submit" class="btn btn-sm sf-btn-danger"
                                                        title="Delete showtime">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>

            @* Pagination *@
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Showtimes pagination" class="mt-3">
                    <ul class="pagination sf-pagination justify-content-center flex-wrap">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageLink(Model.Page - 1)" aria-label="Previous page">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </a>
                        </li>
                        @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")"
                                @(p == Model.Page ? Html.Raw("aria-current=\"page\"") : Html.Raw(""))>
                                <a class="page-link" href="@PageLink(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageLink(Model.Page + 1)" aria-label="Next page">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                    <p class="text-center sf-text-muted mt-1" style="font-size:.8rem">
                        Page @Model.Page of @Model.TotalPages · @Model.TotalCount showtime(s)
                    </p>
                </nav>
            }
            else
            {
                <p class="sf-text-muted mt-2" style="font-size:.8rem">
                    Showing @Model.TotalCount showtime(s)
                </p>
            }
        }

    </div>
</section>

@* sf-confirm.js is loaded globally by _AdminLayout — no per-page script needed *@
