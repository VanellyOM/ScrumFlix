@model ScrumFlix.Areas.Admin.ViewModels.RestockViewModel
@{
    ViewData["Title"] = "Restock";

}

<div class="sf-page-header">
    <div class="container-xl">
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions" class="sf-back-link mb-2 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Concessions
        </a>
        <h1 class="sf-page-title"><i class="bi bi-box-arrow-in-down me-2"></i>Restock — @Model.ItemName</h1>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-4">
                <div class="sf-form-card">

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="sf-stat-card text-center">
                                <div class="sf-stat-value @(Model.CurrentStock <= Model.Minimum ? "text-danger" : "")">@Model.CurrentStock</div>
                                <div class="sf-stat-label">Current Stock</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="sf-stat-card text-center">
                                <div class="sf-stat-value">@Model.Minimum</div>
                                <div class="sf-stat-label">Minimum Level</div>
                            </div>
                        </div>
                    </div>

                    <form asp-area="Admin" asp-controller="AdminManage" asp-action="ConcessionRestock" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="ConcessionItemId" type="hidden" />
                        <input asp-for="ItemName" type="hidden" />
                        <input asp-for="CurrentStock" type="hidden" />
                        <input asp-for="Minimum" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="AddQuantity" class="sf-label"></label>
                            <input asp-for="AddQuantity" class="sf-input" type="number" min="1" />
                            <small class="sf-text-muted d-block mt-1">
                                New total will be <strong>@Model.CurrentStock + entered amount</strong>.
                            </small>
                            <span asp-validation-for="AddQuantity" class="sf-validation"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn sf-btn-primary flex-grow-1">
                                <i class="bi bi-box-arrow-in-down me-2"></i>Add Stock
                            </button>
                            <a asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions" class="btn sf-btn-ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
