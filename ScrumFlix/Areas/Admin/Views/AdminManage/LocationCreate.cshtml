@model ScrumFlix.Areas.Admin.ViewModels.LocationFormViewModel
@{
    var isEdit = Model.LocationId > 0;
    ViewData["Title"] = isEdit ? "Edit Location" : "Add Location";

}

<div class="sf-page-header">
    <div class="container-xl">
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="Locations" class="sf-back-link mb-2 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Locations
        </a>
        <h1 class="sf-page-title">
            <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>@ViewData["Title"]
        </h1>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="sf-form-card">
                    <form asp-area="Admin" asp-controller="AdminManage"
                          asp-action="@(isEdit ? "LocationEdit" : "LocationCreate")" method="post">
                        @Html.AntiForgeryToken()
                        @if (isEdit) { <input asp-for="LocationId" type="hidden" /> }
                        <div asp-validation-summary="ModelOnly" class="sf-flash-banner sf-flash-banner--error mb-4" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="LocationName" class="sf-label"></label>
                            <input asp-for="LocationName" class="sf-input" placeholder="e.g. Downtown Cineplex" />
                            <span asp-validation-for="LocationName" class="sf-validation"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LocationAddress" class="sf-label"></label>
                            <input asp-for="LocationAddress" class="sf-input" placeholder="e.g. 123 Main St" />
                            <span asp-validation-for="LocationAddress" class="sf-validation"></span>
                        </div>

                        <div class="mb-4 d-flex align-items-center gap-2">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            <label asp-for="IsActive" class="sf-label mb-0">Active</label>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn sf-btn-primary flex-grow-1">
                                <i class="bi @(isEdit ? "bi-save" : "bi-plus-circle") me-2"></i>
                                @(isEdit ? "Save Changes" : "Add Location")
                            </button>
                            <a asp-area="Admin" asp-controller="AdminManage" asp-action="Locations" class="btn sf-btn-ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
