@model ScrumFlix.Areas.Admin.ViewModels.ExportViewModel
@using ScrumFlix.Areas.Admin.ViewModels
@{
    ViewData["Title"] = "Export Reports";
}

<div class="sf-page-header">
    <div class="container-xl">
        <h1 class="sf-page-title"><i class="bi bi-download me-2"></i>Export Reports</h1>
        <p class="sf-page-subtitle">Download ticket and concession sales reports in CSV or Excel format.</p>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["ErrorMessage"] is string errMsg)
        {
            <div class="sf-flash-banner sf-flash-banner--danger d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-x-circle-fill flex-shrink-0"></i><span>@errMsg</span>
            </div>
        }
        @if (TempData["InfoMessage"] is string infoMsg)
        {
            <div class="sf-flash-banner sf-flash-banner--info d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-info-circle-fill flex-shrink-0"></i><span>@infoMsg</span>
            </div>
        }

        <div class="row g-4">

            @* ── Tickets ────────────────────────────────────────────── *@
            <div class="col-md-6">
                <div class="sf-form-card h-100">
                    <h2 class="h5 mb-1"><i class="bi bi-ticket-perforated me-2" aria-hidden="true"></i>Tickets Sold</h2>
                    <p class="sf-text-muted mb-4" style="font-size:.875rem">
                        One row per ticket: ticket code, movie, showtime, price, time of sale.
                    </p>
                    <form asp-area="Admin" asp-controller="AdminManage" asp-action="ExportTickets" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="sf-flash-banner sf-flash-banner--danger mb-3" role="alert"></div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label asp-for="DateFrom" class="sf-label"></label>
                                <input asp-for="DateFrom" type="date" class="sf-input" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateFrom" class="sf-validation"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="DateTo" class="sf-label"></label>
                                <input asp-for="DateTo" type="date" class="sf-input" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateTo" class="sf-validation"></span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="sf-label mb-2">Format</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Format" id="t-csv" value="Csv" checked />
                                    <label class="form-check-label" for="t-csv">
                                        <i class="bi bi-filetype-csv me-1"></i>CSV
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Format" id="t-xlsx" value="Excel" />
                                    <label class="form-check-label" for="t-xlsx">
                                        <i class="bi bi-file-earmark-excel me-1 text-success"></i>Excel (.xlsx)
                                    </label>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn sf-btn-primary w-100">
                            <i class="bi bi-download me-2"></i>Download Tickets Report
                        </button>
                    </form>
                </div>
            </div>

            @* ── Concessions ─────────────────────────────────────────── *@
            <div class="col-md-6">
                <div class="sf-form-card h-100">
                    <h2 class="h5 mb-1"><i class="bi bi-cup-straw me-2" aria-hidden="true"></i>Concession Sales</h2>
                    <p class="sf-text-muted mb-4" style="font-size:.875rem">
                        One row per line item: item name, quantity, unit price, line total, time of sale.
                    </p>
                    <form asp-area="Admin" asp-controller="AdminManage" asp-action="ExportConcessions" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="sf-flash-banner sf-flash-banner--danger mb-3" role="alert"></div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label asp-for="DateFrom" class="sf-label"></label>
                                <input asp-for="DateFrom" type="date" class="sf-input" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateFrom" class="sf-validation"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="DateTo" class="sf-label"></label>
                                <input asp-for="DateTo" type="date" class="sf-input" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="DateTo" class="sf-validation"></span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="sf-label mb-2">Format</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Format" id="c-csv" value="Csv" checked />
                                    <label class="form-check-label" for="c-csv">
                                        <i class="bi bi-filetype-csv me-1"></i>CSV
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Format" id="c-xlsx" value="Excel" />
                                    <label class="form-check-label" for="c-xlsx">
                                        <i class="bi bi-file-earmark-excel me-1 text-success"></i>Excel (.xlsx)
                                    </label>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn sf-btn-primary w-100">
                            <i class="bi bi-download me-2"></i>Download Concessions Report
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
