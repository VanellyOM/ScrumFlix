@model ScrumFlix.Areas.Admin.ViewModels.ScreenIndexViewModel
@{
    ViewData["Title"] = "Manage Screens";

}

<div class="sf-page-header">
    <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="sf-page-title"><i class="bi bi-display me-2"></i>Theater Screens</h1>
            <p class="sf-page-subtitle">Manage screens and seating capacity</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="ScreenCreate" class="btn sf-btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Add Screen
        </a>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="sf-flash-banner sf-flash-banner--success d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0"></i><span>@ok</span>
            </div>
        }

        <form asp-area="Admin" asp-controller="AdminManage" asp-action="Screens" method="get" class="d-flex gap-2 mb-4 align-items-end flex-wrap">
            <div>
                <label class="sf-label mb-1">Filter by location</label>
                <select name="locationId" class="sf-select" style="min-width:160px">
                    <option value="">All locations</option>
                    @foreach (var l in Model.Locations)
                    {
                        <option value="@l.LocationId" selected="@(Model.FilterLocationId == l.LocationId)">@l.LocationName</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn sf-btn-outline"><i class="bi bi-funnel me-1"></i>Filter</button>
        </form>

        <div class="table-responsive">
            <table class="table sf-admin-table" aria-label="Theater screens">
                <thead>
                    <tr>
                        <th scope="col">Screen</th>
                        <th scope="col">Location</th>
                        <th scope="col" class="text-end">Capacity</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var screen in Model.Screens)
                    {
                        <tr class="@(!screen.IsActive ? "opacity-50" : "")">
                            <td class="fw-500">@screen.ScreenName</td>
                            <td>@(screen.Location?.LocationName ?? "—")</td>
                            <td class="text-end">@screen.Capacity</td>
                            <td>
                                @if (screen.IsActive)
                                {
                                    <span class="badge sf-badge-ok">Active</span>
                                }
                                else
                                {
                                    <span class="badge sf-badge-oos">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Admin" asp-controller="AdminManage" asp-action="ScreenEdit"
                                   asp-route-id="@screen.TheaterScreenId" class="btn btn-sm sf-btn-outline" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</section>
