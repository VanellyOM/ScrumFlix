@model ScrumFlix.Areas.Admin.ViewModels.ScreenIndexViewModel
@{
    ViewData["Title"] = "Manage Screens";
    string SortLink(string col) {
        var desc = Model.SortBy == col && !Model.SortDesc;
        return Url.Action("Screens", "AdminManage", new { area = "Admin",
            locationId = Model.FilterLocationId,
            sortBy = col, sortDesc = desc, page = 1 })!;
    }
    string SortIcon(string col) => Model.SortBy != col ? "bi-arrow-down-up text-muted"
        : (Model.SortDesc ? "bi-sort-down" : "bi-sort-up");
}

<div class="sf-page-header">
    <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="sf-page-title"><i class="bi bi-display me-2" aria-hidden="true"></i>Theater Screens</h1>
            <p class="sf-page-subtitle">Manage screens and seating capacity</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="ScreenCreate" class="btn sf-btn-primary">
            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Screen
        </a>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="sf-flash-banner sf-flash-banner--success d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@ok</span>
            </div>
        }

        <form asp-area="Admin" asp-controller="AdminManage" asp-action="Screens"
              method="get" class="d-flex gap-2 mb-4 align-items-end flex-wrap">
            <input type="hidden" name="sortBy"   value="@Model.SortBy" />
            <input type="hidden" name="sortDesc" value="@Model.SortDesc.ToString().ToLower()" />
            <div>
                <label class="sf-label mb-1">Filter by location</label>
                <select name="locationId" class="sf-select sf-select--md">
                    <option value="">All locations</option>
                    @foreach (var l in Model.Locations)
                    {
                        <option value="@l.LocationId"
                                selected="@(Model.FilterLocationId == l.LocationId)">
                            @l.LocationName
                        </option>
                    }
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn sf-btn-outline">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filter
                </button>
                @if (Model.FilterLocationId.HasValue)
                {
                    <a asp-area="Admin" asp-controller="AdminManage" asp-action="Screens"
                       class="btn sf-btn-ghost">Clear</a>
                }
            </div>
        </form>

        @if (!Model.Screens.Any())
        {
            <div class="sf-empty-state text-center py-5">
                <i class="bi bi-display sf-empty-icon" aria-hidden="true"></i>
                <p class="sf-text-muted mt-3">
                    @(Model.FilterLocationId.HasValue
                        ? "No screens found for the selected location."
                        : "No screens configured yet.")
                </p>
                <a asp-area="Admin" asp-controller="AdminManage" asp-action="ScreenCreate"
                   class="btn sf-btn-primary mt-2">Add a screen</a>
            </div>
        }
        else
        {
            <div class="sf-admin-table-wrap">
            <div class="table-responsive">
                <table class="table sf-admin-table" id="screens-table" aria-label="Theater screens">
                    <caption class="visually-hidden">
                        Theater Screens — Page @Model.Page of @Model.TotalPages · @Model.TotalCount record(s)
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">
                                <a href="@SortLink("name")" class="text-decoration-none sf-sort-header">
                                    Screen <i class="bi @SortIcon("name") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="@SortLink("location")" class="text-decoration-none sf-sort-header">
                                    Location <i class="bi @SortIcon("location") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-end">
                                <a href="@SortLink("capacity")" class="text-decoration-none sf-sort-header">
                                    Capacity <i class="bi @SortIcon("capacity") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="@SortLink("status")" class="text-decoration-none sf-sort-header">
                                    Status <i class="bi @SortIcon("status") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var screen in Model.Screens)
                        {
                            <tr class="@(!screen.IsActive ? "opacity-50" : "")">
                                <td class="fw-500">@screen.ScreenName</td>
                                <td>@(screen.Location?.LocationName ?? "—")</td>
                                <td class="text-end">@screen.Capacity.ToString("N0")</td>
                                <td>
                                    @if (screen.IsActive)
                                    {
                                        <span class="badge sf-badge-ok">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge sf-badge-oos">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="AdminManage" asp-action="ScreenEdit"
                                       asp-route-id="@screen.TheaterScreenId"
                                       class="btn btn-sm sf-btn-outline"
                                       title="Edit @screen.ScreenName">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Screens pagination" class="mt-3">
                    <ul class="pagination sf-pagination justify-content-center flex-wrap">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Screens","AdminManage",new{area="Admin",locationId=Model.FilterLocationId,sortBy=Model.SortBy,sortDesc=Model.SortDesc,page=Model.Page-1})"
                               aria-label="Previous page">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </a>
                        </li>
                        @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")"
                                @(p == Model.Page ? Html.Raw("aria-current=\"page\"") : Html.Raw(""))>
                                <a class="page-link"
                                   href="@Url.Action("Screens","AdminManage",new{area="Admin",locationId=Model.FilterLocationId,sortBy=Model.SortBy,sortDesc=Model.SortDesc,page=p})">
                                    @p
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Screens","AdminManage",new{area="Admin",locationId=Model.FilterLocationId,sortBy=Model.SortBy,sortDesc=Model.SortDesc,page=Model.Page+1})"
                               aria-label="Next page">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                    <p class="text-center sf-text-muted mt-1" style="font-size:.8rem">
                        Page @Model.Page of @Model.TotalPages · @Model.TotalCount screen(s)
                    </p>
                </nav>
            }
            else
            {
                <p class="sf-text-muted mt-2" style="font-size:.8rem">
                    Showing @Model.TotalCount screen(s)
                    @(Model.FilterLocationId.HasValue ? "at selected location" : "across all locations")
                </p>
            }
        }

    </div>
</section>
