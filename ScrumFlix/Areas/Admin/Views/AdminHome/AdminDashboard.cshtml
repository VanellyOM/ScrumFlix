@*
 * File: /ScrumFlix/Areas/Admin/Views/Home/AdminDashboard.cshtml
 * Description: Admin dashboard — live stat cards, operational overview,
 *              concession inventory, and TMDb coverage summary.
 *
 * Design intent:
 *   The dashboard is a READ-ONLY overview. It links to dedicated management
 *   pages rather than embedding controls or redundant tables that live there.
 *   - TMDb sync controls → TmdbSyncPage (dedicated page, full per-movie table)
 *   - User management   → AdminManage/Users (searchable, paginated, sortable)
 *   - Concession CRUD   → AdminManage/Concessions
 *
 * Removed from earlier version:
 *   - TMDb sync trigger forms (belong on TmdbSyncPage, not the dashboard)
 *   - Full Users table (redundant with AdminManage/Users)
 *   - Duplicate container-xl py-4 nesting
 *   - @section Scripts / SignalR / spinner (not needed without sync controls)
 *   - var tmdb local alias (accessed directly as Model.TmdbSync)
*@
@model ScrumFlix.Areas.Admin.ViewModels.AdminDashboardViewModel
@{
	ViewData["Title"] = "Admin Dashboard";
}

<div class="sf-page-header">
	<div class="container-xl">
		<h1 class="sf-page-title">
			<i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Admin Dashboard
		</h1>
		<p class="sf-page-subtitle">
			@DateTime.Now.ToString("dddd, MMMM d yyyy") &mdash; Overview
		</p>
	</div>
</div>

<div class="container-xl py-4">

	@* ── Flash messages ───────────────────────────────────────────────── *@
	@if (TempData["SuccessMessage"] is string successMsg)
	{
		<div class="sf-flash-banner sf-flash-banner--success d-flex align-items-center gap-2 mb-4" role="alert">
			<i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i>
			<span>@successMsg</span>
		</div>
	}
	@if (TempData["InfoMessage"] is string infoMsg)
	{
		<div class="sf-flash-banner sf-flash-banner--info d-flex align-items-center gap-2 mb-4" role="alert">
			<i class="bi bi-info-circle-fill flex-shrink-0" aria-hidden="true"></i>
			<span>@infoMsg</span>
		</div>
	}
	@if (TempData["ErrorMessage"] is string errorMsg)
	{
		<div class="sf-flash-banner sf-flash-banner--danger d-flex align-items-center gap-2 mb-4" role="alert">
			<i class="bi bi-x-circle-fill flex-shrink-0" aria-hidden="true"></i>
			<span>@errorMsg</span>
		</div>
	}

	@* ── Low-stock alert banner ───────────────────────────────────────── *@
	@if (Model.HasLowStockItems)
	{
		<div class="sf-flash-banner sf-flash-banner--warning d-flex align-items-center gap-2 mb-4" role="alert">
			<i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
			<span>
				<strong>@Model.LowStockCount concession item@(Model.LowStockCount == 1 ? "" : "s")</strong>
				below minimum stock level.
				<a href="#section-inventory" class="sf-text-link ms-1">Review inventory</a>
			</span>
		</div>
	}

	@* ── Today's Summary ──────────────────────────────────────────────── *@
	<section id="section-today" aria-labelledby="today-heading" class="mb-5">
		<h2 id="today-heading" class="sf-section-title mb-4">
			<span class="sf-gold-bar" aria-hidden="true"></span>Today's Summary
		</h2>
		<div class="row g-3">
			<div class="col-6 col-xl-3">
				<div class="sf-stat-card">
					<i class="bi bi-ticket-perforated sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.TicketsSoldToday</div>
					<div class="sf-stat-label">Tickets Sold Today</div>
				</div>
			</div>
			<div class="col-6 col-xl-3">
				<div class="sf-stat-card">
					<i class="bi bi-currency-dollar sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.RevenueTodayFormatted</div>
					<div class="sf-stat-label">Ticket Revenue Today</div>
				</div>
			</div>
			<div class="col-6 col-xl-3">
				<div class="sf-stat-card">
					<i class="bi bi-cup-straw sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.ConcessionsSoldToday</div>
					<div class="sf-stat-label">Concessions Sold Today</div>
				</div>
			</div>
			<div class="col-6 col-xl-3">
				<div class="sf-stat-card">
					<i class="bi bi-display sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.ActiveShowtimes</div>
					<div class="sf-stat-label">Active Showtimes</div>
				</div>
			</div>
		</div>
	</section>

	@* ── Catalog Overview ─────────────────────────────────────────────── *@
	<section aria-labelledby="catalog-heading" class="mb-5">
		<h2 id="catalog-heading" class="sf-section-title mb-4">
			<span class="sf-gold-bar" aria-hidden="true"></span>Catalog
		</h2>
		<div class="row g-3">
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card">
					<i class="bi bi-film sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.TotalMovies</div>
					<div class="sf-stat-label">Movies in Catalog</div>
					<a asp-area="Admin" asp-controller="Movies" asp-action="MovieCatalog"
					   class="sf-admin-card-link mt-2">
						Manage <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
					</a>
				</div>
			</div>
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card">
					<i class="bi bi-geo-alt sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.TotalLocations</div>
					<div class="sf-stat-label">Theater Locations</div>
					<a asp-area="Admin" asp-controller="AdminManage" asp-action="Locations"
					   class="sf-admin-card-link mt-2">
						Manage <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
					</a>
				</div>
			</div>
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card @(Model.HasLowStockItems ? "sf-stat-card--alert" : "")">
					<i class="bi bi-box-seam sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value @(Model.HasLowStockItems ? "sf-stat-value--danger" : "")">
						@Model.LowStockCount
					</div>
					<div class="sf-stat-label">Low Stock Items</div>
					@if (Model.HasLowStockItems)
					{
						<a href="#section-inventory" class="sf-admin-card-link mt-2">
							Review <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
						</a>
					}
				</div>
			</div>
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card">
					<i class="bi bi-people sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.TotalUsers</div>
					<div class="sf-stat-label">Staff Users</div>
					<a asp-area="Admin" asp-controller="AdminManage" asp-action="Users"
					   class="sf-admin-card-link mt-2">
						Manage <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
					</a>
				</div>
			</div>
		</div>
	</section>

	@* ── TMDb Coverage Summary ────────────────────────────────────────── *@
	@* Read-only coverage stats only. Sync controls live on TmdbSyncPage. *@
	<section id="section-tmdb" aria-labelledby="tmdb-heading" class="mb-5">
		<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
			<h2 id="tmdb-heading" class="sf-section-title mb-0">
				<span class="sf-gold-bar" aria-hidden="true"></span>TMDb Coverage
			</h2>
			<a asp-area="Admin" asp-controller="AdminHome" asp-action="TmdbSyncPage"
			   class="btn sf-btn-outline btn-sm">
				<i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Sync &amp; Details
			</a>
		</div>

		@if (!Model.TmdbSync.ApiKeyConfigured)
		{
			<div class="sf-flash-banner sf-flash-banner--warning d-flex align-items-center gap-2 mb-4" role="alert">
				<i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
				<span>
					<strong>TMDb API key not configured.</strong>
					Set <code>Tmdb:ApiKey</code> in User Secrets or the
					<code>Tmdb__ApiKey</code> environment variable.
				</span>
			</div>
		}

		<div class="row g-3 mb-4">
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card">
					<i class="bi bi-collection-fill sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">
						@Model.TmdbSync.MoviesWithMetadata
						<span class="sf-stat-denom">/ @Model.TmdbSync.TotalMovies</span>
					</div>
					<div class="sf-stat-label">Movies Synced</div>
				</div>
			</div>
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card">
					<i class="bi bi-image sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.TmdbSync.MoviesWithPoster</div>
					<div class="sf-stat-label">With Poster</div>
				</div>
			</div>
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card">
					<i class="bi bi-play-circle sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">@Model.TmdbSync.MoviesWithTrailer</div>
					<div class="sf-stat-label">With Trailer</div>
				</div>
			</div>
			<div class="col-6 col-lg-3">
				<div class="sf-stat-card">
					<i class="bi bi-percent sf-stat-icon" aria-hidden="true"></i>
					<div class="sf-stat-value">
						@Model.TmdbSync.CoveragePercent<span class="sf-stat-denom">%</span>
					</div>
					<div class="sf-stat-label">Coverage</div>
				</div>
			</div>
		</div>

		<div>
			<div class="d-flex justify-content-between mb-1">
				<small class="sf-text-muted">Metadata coverage</small>
				<small class="sf-text-muted">
					@Model.TmdbSync.MoviesWithMetadata of @Model.TmdbSync.TotalMovies movies
				</small>
			</div>
			<div class="progress" style="height:8px;" role="progressbar"
			     aria-valuenow="@Model.TmdbSync.CoveragePercent"
			     aria-valuemin="0" aria-valuemax="100"
			     aria-label="TMDb metadata coverage @Model.TmdbSync.CoveragePercent%">
				<div class="progress-bar @(Model.TmdbSync.CoveragePercent == 100 ? "bg-success"
				                          : Model.TmdbSync.CoveragePercent > 50  ? "bg-info"
				                          : "bg-warning")"
				     style="width:@Model.TmdbSync.CoveragePercent%"></div>
			</div>
		</div>
	</section>

	@* ── Concession Inventory ─────────────────────────────────────────── *@
	<section id="section-inventory" aria-labelledby="inventory-heading" class="mb-5">
		<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
			<h2 id="inventory-heading" class="sf-section-title mb-0">
				<span class="sf-gold-bar" aria-hidden="true"></span>Concession Inventory
			</h2>
			<a asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions"
			   class="btn sf-btn-outline btn-sm">
				Manage <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
			</a>
		</div>
		@if (Model.ConcessionItems.Any())
		{
			<div class="sf-admin-table-wrap">
			<div class="table-responsive">
				<table class="table sf-admin-table" aria-label="Concession inventory">
					<thead>
						<tr>
							<th scope="col">Item</th>
							<th scope="col" class="text-end">Price</th>
							<th scope="col" class="text-end">In Stock</th>
							<th scope="col" class="text-end">Min Stock</th>
							<th scope="col">Status</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model.ConcessionItems.OrderBy(i => i.QuantityInStock))
						{
							var isLow = item.QuantityInStock <= item.Minimum;
							<tr class="@(isLow ? "sf-row-warning" : "")">
								<td>@item.ItemName</td>
								<td class="text-end">@item.Price.ToString("C")</td>
								<td class="text-end">@item.QuantityInStock</td>
								<td class="text-end">@item.Minimum</td>
								<td>
									@if (item.QuantityInStock <= 0)
									{
										<span class="badge sf-badge-oos">Out of Stock</span>
									}
									else if (isLow)
									{
										<span class="badge sf-badge-low-stock">
											<i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Low
										</span>
									}
									else
									{
										<span class="badge sf-badge-ok">OK</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			</div>
		}
		else
		{
			<p class="sf-text-muted">No concession items found.</p>
		}
	</section>

</div>
