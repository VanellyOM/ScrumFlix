@*
 * File: Areas/Admin/Views/Movies/MovieCatalog.cshtml
 * Model: ScrumFlix.Areas.Admin.ViewModels.AdminMovieCatalogViewModel
 *
 * Server-side sort (title/genre/rating/runtime/poster/trailer),
 * filter bar (title search, genre, rating, runtime range, poster, trailer),
 * and pagination — all parameters preserved across sort and page navigation.
 *
 * Delete confirm uses sf-confirm-form + data-confirm (CSP-compliant).
 * sf-confirm.js is loaded globally by _AdminLayout.
 *@
@model ScrumFlix.Areas.Admin.ViewModels.AdminMovieCatalogViewModel
@{
	ViewData["Title"] = "Movie Catalog (Staff View)";

	// Builds a sort-toggle link that preserves all active filter values and
	// resets to page 1. Clicking the active column reverses direction.
	string SortLink(string col)
	{
		var desc = Model.SortBy == col && !Model.SortDesc;
		return Url.Action("MovieCatalog", "Movies", new
		{
			area = "Admin",
			search = Model.SearchTerm,
			genre = Model.FilterGenre,
			rating = Model.FilterRating,
			runtimeMin = Model.FilterRuntimeMin,
			runtimeMax = Model.FilterRuntimeMax,
			poster = Model.FilterPoster.HasValue ? (Model.FilterPoster.Value ? "yes" : "no") : null,
			trailer = Model.FilterTrailer.HasValue ? (Model.FilterTrailer.Value ? "yes" : "no") : null,
			sortBy = col,
			sortDesc = desc,
			page = 1
		})!;
	}
	string SortIcon(string col) => Model.SortBy != col ? "bi-arrow-down-up text-muted"
		: (Model.SortDesc ? "bi-sort-down" : "bi-sort-up");

	// Centralised page-link builder — avoids repeating all params three times.
	string PageLink(int p) => Url.Action("MovieCatalog", "Movies", new
	{
		area = "Admin",
		search = Model.SearchTerm,
		genre = Model.FilterGenre,
		rating = Model.FilterRating,
		runtimeMin = Model.FilterRuntimeMin,
		runtimeMax = Model.FilterRuntimeMax,
		poster = Model.FilterPoster.HasValue ? (Model.FilterPoster.Value ? "yes" : "no") : null,
		trailer = Model.FilterTrailer.HasValue ? (Model.FilterTrailer.Value ? "yes" : "no") : null,
		sortBy = Model.SortBy,
		sortDesc = Model.SortDesc,
		page = p
	})!;

	// Current poster/trailer filter value for <select> pre-selection.
	string posterVal = Model.FilterPoster.HasValue ? (Model.FilterPoster.Value ? "yes" : "no") : "";
	string trailerVal = Model.FilterTrailer.HasValue ? (Model.FilterTrailer.Value ? "yes" : "no") : "";
}

<div class="sf-page-header">
	<div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
		<div>
			<h1 class="sf-page-title"><i class="bi bi-film me-2" aria-hidden="true"></i>Movie Catalog</h1>
			<p class="sf-page-subtitle">
				<span class="badge bg-info text-dark me-2"><i class="bi bi-eye me-1" aria-hidden="true"></i>Staff View</span>
				This is exactly what movie goers see — plus admin controls.
			</p>
		</div>
		<a asp-area="Admin" asp-controller="Movies" asp-action="MovieCreate" class="btn sf-btn-primary">
			<i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Movie
		</a>
	</div>
</div>

<section class="sf-section">
	<div class="container-xl">

		@if (TempData["SuccessMessage"] is string ok)
		{
			<div class="sf-flash-banner sf-flash-banner--success d-flex gap-2 align-items-center mb-4" role="alert">
				<i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@ok</span>
			</div>
		}

		@* ── Filter bar ──────────────────────────────────────────────────── *@
		<form method="get" asp-area="Admin" asp-controller="Movies" asp-action="MovieCatalog"
			  class="d-flex flex-wrap gap-2 mb-4 align-items-end">
			@* Preserve sort state when filter form is submitted *@
			<input type="hidden" name="sortBy" value="@Model.SortBy" />
			<input type="hidden" name="sortDesc" value="@Model.SortDesc" />

			@* Title search *@
			<div>
				<label class="sf-label mb-1">Title</label>
				<div class="sf-search-wrap">
					<i class="bi bi-search sf-search-icon" aria-hidden="true"></i>
					<input type="text" name="search" value="@Model.SearchTerm"
						   class="sf-search-input" placeholder="Search title…" autocomplete="off" />
				</div>
			</div>

			@* Genre *@
			<div>
				<label class="sf-label mb-1">Genre</label>
				<select name="genre" class="sf-select sf-select--md">
					<option value="">All genres</option>
					@foreach (var g in Model.Genres)
					{
						<option value="@g" selected="@(Model.FilterGenre == g)">@g</option>
					}
				</select>
			</div>

			@* Rating *@
			<div>
				<label class="sf-label mb-1">Rating</label>
				<select name="rating" class="sf-select sf-select--md">
					<option value="">All ratings</option>
					@foreach (var r in Model.Ratings)
					{
						<option value="@r" selected="@(Model.FilterRating == r)">@r</option>
					}
				</select>
			</div>

			@* Runtime range *@
			@*       <div>
                <label class="sf-label mb-1">Runtime (min)</label>
                <div class="d-flex gap-1 align-items-center">
                    <input type="number" name="runtimeMin" value="@Model.FilterRuntimeMin"
                           class="sf-input" style="width:72px" placeholder="Min" min="1" max="999" />
                    <span class="sf-text-muted" style="font-size:.8rem">–</span>
                    <input type="number" name="runtimeMax" value="@Model.FilterRuntimeMax"
                           class="sf-input" style="width:72px" placeholder="Max" min="1" max="999" />
                </div>
            </div> *@

			@* Poster *@
			<div>
				<label class="sf-label mb-1">Poster</label>
				<select name="poster" class="sf-select sf-select--md">
					<option value="" selected="@(posterVal == "")">All</option>
					<option value="yes" selected="@(posterVal == "yes")">Has poster</option>
					<option value="no" selected="@(posterVal == "no")">No poster</option>
				</select>
			</div>

			@* Trailer *@
			<div>
				<label class="sf-label mb-1">Trailer</label>
				<select name="trailer" class="sf-select sf-select--md">
					<option value="" selected="@(trailerVal == "")">All</option>
					<option value="yes" selected="@(trailerVal == "yes")">Has trailer</option>
					<option value="no" selected="@(trailerVal == "no")">No trailer</option>
				</select>
			</div>

			<div class="d-flex gap-2 align-self-end">
				<button type="submit" class="btn sf-btn-outline">
					<i class="bi bi-funnel me-1" aria-hidden="true"></i>Filter
				</button>
				@if (Model.HasActiveFilter)
				{
					<a asp-area="Admin" asp-controller="Movies" asp-action="MovieCatalog"
					   class="btn sf-btn-ghost">Clear</a>
				}
			</div>
		</form>

		@* ── Empty state ─────────────────────────────────────────────────── *@
		@if (!Model.Movies.Any())
		{
			<div class="sf-empty-state text-center py-5">
				<i class="bi bi-film sf-empty-icon" aria-hidden="true"></i>
				<p class="sf-text-muted mt-3">No movies match the current filter.</p>
			</div>
		}
		else
		{
			<div class="sf-admin-table-wrap">
				<div class="table-responsive">
					<table class="table sf-admin-table" aria-label="Movie catalog staff view">
						<caption class="visually-hidden">
							Movies — Page @Model.Page of @Model.TotalPages · @Model.TotalCount record(s)
						</caption>
						<thead>
							<tr>
								<th scope="col">
									<a href="@SortLink("title")" class="text-decoration-none sf-sort-header">
										Title <i class="bi @SortIcon("title") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
									</a>
								</th>
								<th scope="col">
									<a href="@SortLink("genre")" class="text-decoration-none sf-sort-header">
										Genre <i class="bi @SortIcon("genre") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
									</a>
								</th>
								<th scope="col">
									<a href="@SortLink("rating")" class="text-decoration-none sf-sort-header">
										Rating <i class="bi @SortIcon("rating") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
									</a>
								</th>
								<th scope="col">
									<a href="@SortLink("runtime")" class="text-decoration-none sf-sort-header">
										Runtime <i class="bi @SortIcon("runtime") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
									</a>
								</th>
								<th scope="col">
									<a href="@SortLink("poster")" class="text-decoration-none sf-sort-header">
										Poster <i class="bi @SortIcon("poster") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
									</a>
								</th>
								<th scope="col">
									<a href="@SortLink("trailer")" class="text-decoration-none sf-sort-header">
										Trailer <i class="bi @SortIcon("trailer") ms-1" style="font-size:.7rem" aria-hidden="true"></i>
									</a>
								</th>
								<th scope="col" class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var m in Model.Movies)
							{
								var hasPoster = m.TmdbMetadata?.PosterPath != null;
								var hasTrailer = m.TmdbMetadata?.TrailerYouTubeKey != null;
								<tr>
									<td><strong>@m.Title</strong></td>
									<td><span class="sf-genre-pill">@m.Genre</span></td>
									<td><span class="sf-rating-badge">@m.Rating</span></td>
									<td>@m.RuntimeMinutes min</td>
									<td>
										@if (hasPoster)
										{
											<i class="bi bi-check-circle-fill text-success" title="Poster available" aria-label="Poster available"></i>
										}
										else
										{
											<i class="bi bi-x-circle text-danger" title="No poster" aria-label="No poster"></i>
										}
									</td>
									<td>
										@if (hasTrailer)
										{
											<i class="bi bi-check-circle-fill text-success" title="Trailer available" aria-label="Trailer available"></i>
										}
										else
										{
											<i class="bi bi-x-circle text-danger" title="No trailer" aria-label="No trailer"></i>
										}
									</td>
									<td class="text-end">
										<button type="button"
										        class="btn btn-sm sf-btn-ghost me-1"
										        title="Preview '@m.Title'"
										        data-movie-preview-url="@Url.Action("MovieDetailPreview", "Movies", new { area = "Admin", id = m.MovieId })"
										        data-movie-preview-title="@m.Title">
										    <i class="bi bi-eye" aria-hidden="true"></i>
										</button>
										<a asp-area="Admin" asp-controller="Movies" asp-action="MovieEdit"
										   asp-route-id="@m.MovieId" class="btn btn-sm sf-btn-secondary me-1" title="Edit">
											<i class="bi bi-pencil" aria-hidden="true"></i>
										</a>
										<form asp-area="Admin" asp-controller="Movies" asp-action="MovieDelete"
											  method="post" style="display:inline"
											  class="sf-confirm-form"
											  data-confirm="Delete '@m.Title'? This cannot be undone.">
											@Html.AntiForgeryToken()
											<input type="hidden" name="id" value="@m.MovieId" />
											<button type="submit" class="btn btn-sm sf-btn-danger" title="Delete">
												<i class="bi bi-trash" aria-hidden="true"></i>
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			@* ── Pagination ──────────────────────────────────────────────── *@
			@if (Model.TotalPages > 1)
			{
				<nav aria-label="Movie catalog pagination" class="mt-3">
					<ul class="pagination sf-pagination justify-content-center flex-wrap">
						<li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
							<a class="page-link" href="@PageLink(Model.Page - 1)" aria-label="Previous page">
								<i class="bi bi-chevron-left" aria-hidden="true"></i>
							</a>
						</li>
						@for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
						{
							<li class="page-item @(p == Model.Page ? "active" : "")"
								@(p == Model.Page ? Html.Raw("aria-current=\"page\"") : Html.Raw(""))>
								<a class="page-link" href="@PageLink(p)">@p</a>
							</li>
						}
						<li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
							<a class="page-link" href="@PageLink(Model.Page + 1)" aria-label="Next page">
								<i class="bi bi-chevron-right" aria-hidden="true"></i>
							</a>
						</li>
					</ul>
					<p class="text-center sf-text-muted mt-1" style="font-size:.8rem">
						Page @Model.Page of @Model.TotalPages · @Model.TotalCount movie(s)
					</p>
				</nav>
			}
			else
			{
				<p class="sf-text-muted mt-2" style="font-size:.8rem">
					Showing @Model.TotalCount movie(s)
				</p>
			}
		}

	</div>
</section>

@* sf-confirm.js loaded globally by _AdminLayout — no per-page script needed *@

@section Scripts {
    @* sf-movie-preview.js wires the eye-button → Bootstrap modal fetch *@
    <script src="~/js/sf-movie-preview.js" asp-append-version="true"></script>
}
