@*
 * File: /Areas/Admin/Views/Movies/MovieCreate.cshtml
 * Description: Admin-area form for creating a new movie entry.
 *              Bound to MovieFormViewModel — uses genre multiselect dropdown
 *              backed by the Genres table rather than a free-text field.
 *              Submits to Admin/Movies/MovieCreate and returns to Admin MovieCatalog.
 *
 * Fixes applied vs. previous version:
 *   - Submit button: added missing base 'btn' class (was sf-btn-primary only,
 *     Bootstrap's interactive states require the btn base class to render).
 *   - Cancel link: added missing 'btn' class.
 *   - Added novalidate to suppress browser-native validation bubbles (jQuery
 *     Unobtrusive Validation owns client-side feedback, not the browser).
 *   - Added aria-hidden="true" to all decorative Bootstrap Icons.
 *   - Added back-link to MovieCatalog in the page header (consistency with
 *     all other Admin Create/Edit views).
 *   - Inline <script> block removed — logic moved to /wwwroot/js/sf-movie-genre.js
 *     to comply with the CSP script-src 'unsafe-inline' exclusion.
*@
@model ScrumFlix.Areas.Admin.ViewModels.MovieFormViewModel
@{
    ViewData["Title"] = "Add Movie";
}

<div class="sf-page-header">
    <div class="container-xl">
        <a asp-area="Admin" asp-controller="Movies" asp-action="MovieCatalog"
           class="sf-back-link mb-2 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Movies
        </a>
        <h1 class="sf-page-title">
            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Movie
        </h1>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="sf-form-card">
                    <form asp-area="Admin" asp-controller="Movies" asp-action="MovieCreate"
                          method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly"
                             class="sf-flash-banner sf-flash-banner--error mb-4" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="sf-label"></label>
                            <input asp-for="Title" class="sf-input"
                                   placeholder="e.g. The Last Orbit"
                                   maxlength="200" />
                            <span asp-validation-for="Title" class="sf-validation"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rating" class="sf-label"></label>
                            <select asp-for="Rating" class="sf-select">
                                <option value="">Select rating…</option>
                                <option value="G">G</option>
                                <option value="PG">PG</option>
                                <option value="PG-13">PG-13</option>
                                <option value="R">R</option>
                                <option value="NC-17">NC-17</option>
                            </select>
                            <span asp-validation-for="Rating" class="sf-validation"></span>
                        </div>

                        @* ── Genre multiselect ─────────────────────────────────────── *@
                        @if (Model.AvailableGenres.Any())
                        {
                            <div class="mb-3">
                                <label class="sf-label" for="genreMultiselect">
                                    Genres
                                    <span class="sf-text-muted" style="font-weight:400;">
                                        (hold Ctrl / ⌘ to select multiple)
                                    </span>
                                </label>
                                <select name="SelectedGenreIds"
                                        multiple
                                        class="sf-select"
                                        style="height:auto;min-height:120px;"
                                        id="genreMultiselect">
                                    @foreach (var genre in Model.AvailableGenres)
                                    {
                                        var isSelected = Model.SelectedGenreIds.Contains(genre.GenreId);
                                        <option value="@genre.GenreId"
                                                selected="@(isSelected ? "selected" : null)">
                                            @genre.Name
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="SelectedGenreIds" class="sf-validation"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="PrimaryGenreId" class="sf-label"></label>
                                <select asp-for="PrimaryGenreId" class="sf-select" id="primaryGenreSelect">
                                    <option value="0">Select primary genre…</option>
                                    @foreach (var genre in Model.AvailableGenres)
                                    {
                                        <option value="@genre.GenreId">@genre.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="PrimaryGenreId" class="sf-validation"></span>
                                <small class="sf-text-muted d-block mt-1">
                                    Must be one of the genres selected above. Used for display and primary filtering.
                                </small>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 sf-flash-banner sf-flash-banner--info" role="status">
                                No genres available. Run a TMDb sync or add genres first.
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="RuntimeMinutes" class="sf-label"></label>
                            <input asp-for="RuntimeMinutes" class="sf-input"
                                   type="number" min="1" max="999"
                                   placeholder="Runtime in minutes" />
                            <span asp-validation-for="RuntimeMinutes" class="sf-validation"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="sf-label"></label>
                            <textarea asp-for="Description" class="sf-input" rows="4"
                                      placeholder="Plot synopsis (up to 1000 characters)…"
                                      maxlength="1000"></textarea>
                            <span asp-validation-for="Description" class="sf-validation"></span>
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn sf-btn-primary flex-grow-1">
                                <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Movie
                            </button>
                            <a asp-area="Admin" asp-controller="Movies" asp-action="MovieCatalog"
                               class="btn sf-btn-ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* Genre multiselect ↔ primary genre sync — external for CSP compliance *@
    <script src="~/js/sf-movie-genre.js" asp-append-version="true"></script>
}
