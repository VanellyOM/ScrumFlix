@model ScrumFlix.Areas.Admin.ViewModels.ConcessionIndexViewModel
@{
    ViewData["Title"] = "Manage Concessions";
}

<div class="sf-page-header">
    <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="sf-page-title">
                <i class="bi bi-cup-straw me-2" aria-hidden="true"></i>Concession Items
            </h1>
            <p class="sf-page-subtitle">Manage inventory and pricing</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="ConcessionCreate"
           class="btn sf-btn-primary">
            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Item
        </a>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="sf-flash-banner sf-flash-banner--success d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i><span>@ok</span>
            </div>
        }

        @if (Model.LowStockCount > 0)
        {
            <div class="sf-flash-banner sf-flash-banner--warning d-flex gap-2 align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
                <span><strong>@Model.LowStockCount item(s)</strong> are at or below minimum stock.</span>
            </div>
        }

        @* Server-side filter — locationId + showInactive are real controller params *@
        <form asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions"
              method="get" class="d-flex gap-2 mb-4 align-items-end flex-wrap">
            <div>
                <label class="sf-label mb-1">Location</label>
                <select name="locationId" class="sf-select sf-select--md">
                    <option value="">All locations</option>
                    @foreach (var l in Model.Locations)
                    {
                        <option value="@l.LocationId"
                                selected="@(Model.FilterLocationId == l.LocationId)">
                            @l.LocationName
                        </option>
                    }
                </select>
            </div>
            <div class="d-flex align-items-center gap-2 align-self-end pb-1">
                <input type="checkbox" id="showInactive" name="showInactive" value="true"
                       @(Model.ShowInactive ? "checked" : "") class="form-check-input" />
                <label for="showInactive" class="sf-label mb-0">Show inactive</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn sf-btn-outline">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filter
                </button>
                @if (Model.FilterLocationId.HasValue || Model.ShowInactive)
                {
                    <a asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions"
                       class="btn sf-btn-ghost">Clear</a>
                }
            </div>
        </form>

        @if (!Model.Items.Any())
        {
            <div class="sf-empty-state text-center py-5">
                <i class="bi bi-cup sf-empty-icon" aria-hidden="true"></i>
                <p class="sf-text-muted mt-3">No concession items found.</p>
            </div>
        }
        else
        {
            <div class="sf-admin-table-wrap">
            <div class="table-responsive">
                <table class="table sf-admin-table" id="concessions-table" aria-label="Concession items">
                    <caption class="visually-hidden">Concession items — @Model.Items.Count record(s)</caption>
                    <thead>
                        <tr>
                            <th scope="col" data-sort-col="0" style="cursor:pointer">
                                Item <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col" data-sort-col="1" style="cursor:pointer">
                                Location <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col" class="text-end" data-sort-col="2" style="cursor:pointer">
                                Price <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col" class="text-end" data-sort-col="3" style="cursor:pointer">
                                In Stock <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col" class="text-end">Min</th>
                            <th scope="col" data-sort-col="5" style="cursor:pointer">
                                Status <i class="bi bi-arrow-down-up ms-1 text-muted" style="font-size:.7rem" aria-hidden="true"></i>
                            </th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Items pre-sorted by QuantityInStock ascending by the controller *@
                        @foreach (var item in Model.Items.OrderBy(i => i.QuantityInStock))
                        {
                            var isLow = item.IsLowStock;
                            <tr class="@(!item.IsActive ? "opacity-50" : isLow ? "sf-row-warning" : "")">
                                <td class="fw-500">@item.ItemName</td>
                                <td>@(item.Location?.LocationName ?? "—")</td>
                                <td class="text-end">@item.Price.ToString("C")</td>
                                <td class="text-end @(isLow ? "text-danger fw-500" : "")">
                                    @item.QuantityInStock
                                </td>
                                <td class="text-end">@item.Minimum</td>
                                <td>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge sf-badge-oos">Inactive</span>
                                    }
                                    else if (item.QuantityInStock <= 0)
                                    {
                                        <span class="badge sf-badge-oos">Out of Stock</span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge sf-badge-low-stock">
                                            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Low
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge sf-badge-ok">OK</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-area="Admin" asp-controller="AdminManage"
                                           asp-action="ConcessionEdit"
                                           asp-route-id="@item.ConcessionItemId"
                                           class="btn btn-sm sf-btn-outline"
                                           title="Edit @item.ItemName">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="AdminManage"
                                           asp-action="ConcessionRestock"
                                           asp-route-id="@item.ConcessionItemId"
                                           class="btn btn-sm sf-btn-ghost"
                                           title="Restock @item.ItemName">
                                            <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
            <p class="sf-text-muted mt-2" style="font-size:.8rem">
                @Model.Items.Count item(s)
                @(Model.FilterLocationId.HasValue ? "at selected location" : "")
                @(Model.ShowInactive ? "(including inactive)" : "(active only)")
            </p>
        }

    </div>
</section>

@section Scripts {
<script src="~/js/sf-admin-tables.js"></script>
<script>
    document.querySelectorAll('th[data-sort-col]').forEach(th => {
        th.addEventListener('click', () =>
            sortTable('concessions-table', parseInt(th.dataset.sortCol, 10)));
    });
</script>
}
