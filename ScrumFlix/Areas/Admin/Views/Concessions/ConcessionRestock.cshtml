@model ScrumFlix.Areas.Admin.ViewModels.RestockViewModel
@{
    ViewData["Title"] = "Restock — " + Model.ItemName;
}

<div class="sf-page-header">
    <div class="container-xl">
        <a asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions"
           class="sf-back-link mb-2 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Concessions
        </a>
        <h1 class="sf-page-title">
            <i class="bi bi-box-arrow-in-down me-2" aria-hidden="true"></i>Restock — @Model.ItemName
        </h1>
    </div>
</div>

<section class="sf-section">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-4">
                <div class="sf-form-card">

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="sf-stat-card text-center">
                                <div class="sf-stat-value @(Model.CurrentStock <= Model.Minimum ? "text-danger" : "")">
                                    @Model.CurrentStock
                                </div>
                                <div class="sf-stat-label">Current Stock</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="sf-stat-card text-center">
                                <div class="sf-stat-value">@Model.Minimum</div>
                                <div class="sf-stat-label">Minimum Level</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.CurrentStock <= Model.Minimum)
                    {
                        <div class="sf-flash-banner sf-flash-banner--warning d-flex gap-2 align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
                            <span>Stock is at or below the minimum threshold.</span>
                        </div>
                    }

                    <form asp-area="Admin" asp-controller="AdminManage" asp-action="ConcessionRestock"
                          method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="ConcessionItemId" type="hidden" />
                        <input asp-for="ItemName" type="hidden" />
                        <input asp-for="CurrentStock" type="hidden" />
                        <input asp-for="Minimum" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="AddQuantity" class="sf-label"></label>
                            <input asp-for="AddQuantity" class="sf-input" type="number"
                                   min="1" id="addQtyInput" />
                            <small class="sf-text-muted d-block mt-1">
                                New total will be
                                <strong id="newTotalPreview">@Model.CurrentStock</strong>.
                            </small>
                            <span asp-validation-for="AddQuantity" class="sf-validation"></span>
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn sf-btn-primary flex-grow-1">
                                <i class="bi bi-box-arrow-in-down me-2" aria-hidden="true"></i>Add Stock
                            </button>
                            <a asp-area="Admin" asp-controller="AdminManage" asp-action="Concessions"
                               class="btn sf-btn-ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const currentStock = @Model.CurrentStock;
            const input = document.getElementById('addQtyInput');
            const preview = document.getElementById('newTotalPreview');
            if (!input || !preview) return;
            input.addEventListener('input', () => {
                const add = parseInt(input.value, 10);
                preview.textContent = (!isNaN(add) && add > 0)
                    ? (currentStock + add).toLocaleString()
                    : currentStock.toLocaleString();
            });
        })();
    </script>
}
